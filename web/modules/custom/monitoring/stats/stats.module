<?php

/**
 * @file
 * Custom module which provides implementation of stats functionality.
 */

/**
 * Implements hook_theme().
 */
function stats_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'stats_page' => [
      'template' => 'stats-page',
      'variables' => [
        'period_bar' => [],
        'range_form' => [],
        'sections' => [],
      ],
    ],
    'stats_tiles' => [
      'template' => 'stats-tiles',
      'variables' => [
        'tiles' => [],
        'attributes' => [],
      ],
    ],
  ];
}
