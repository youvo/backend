{#
/**
 * @file
 * The stats page: period card, KPI tiles and the sections of the charts.
 *
 * Available variables:
 * - period_bar: The heading, the preset links and the navigation links.
 * - range_form: The form of a custom date range.
 * - kpis: The tiles of the current totals with value and label.
 * - sections: The render array of the chart sections.
 */
#}
<div class="stats-page">
  <div class="stats-period">
    <p class="stats-period-label">{{ 'Period'|t }}</p>
    <h2 class="stats-period-heading">{{ period_bar.heading }}</h2>

    <div class="stats-period-controls">
      <div class="stats-period-links">
        <ul class="stats-pills" aria-label="{{ 'Periods'|t }}">
          {% for preset in period_bar.presets %}
            <li><a href="{{ preset.url }}" class="stats-pill"{% if preset.active %} aria-current="page"{% endif %}>{{ preset.label }}</a></li>
          {% endfor %}
        </ul>

        {% if period_bar.navigation %}
          <ul class="stats-pills" aria-label="{{ 'Neighbor periods'|t }}">
            <li><a href="{{ period_bar.navigation.previous.url }}" class="stats-pill" rel="prev">{{ period_bar.navigation.previous.label }}</a></li>
            {% if period_bar.navigation.next %}
              <li><a href="{{ period_bar.navigation.next.url }}" class="stats-pill" rel="next">{{ period_bar.navigation.next.label }}</a></li>
            {% endif %}
          </ul>
        {% endif %}
      </div>

      {{ range_form }}
    </div>
  </div>

  <section class="stats-totals" aria-labelledby="stats-totals-title">
    <h2 class="stats-totals-title" id="stats-totals-title">{{ 'Totals'|t }}</h2>
    <p class="stats-totals-hint">{{ 'Current, independent of the period'|t }}</p>
    {% include '@stats/stats-tiles.html.twig' with {tiles: kpis, attributes: create_attribute()} only %}
  </section>

  {{ sections }}
</div>
