<?php

/**
 * @file
 * Install, update and uninstall functions for the oauth_grant module.
 */

use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
use Drupal\Component\Plugin\Exception\PluginNotFoundException;
use Drupal\consumers\Entity\Consumer;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Utility\Error;

/**
 * Implements hook_install().
 */
function oauth_grant_install(): void {

  // Overwrite simple_oauth settings. Token lifetimes and consent behavior live
  // on the consumers since simple_oauth 6.
  $config = \Drupal::configFactory()->getEditable('simple_oauth.settings');
  $config->set('disable_openid_connect', TRUE);
  $config->set('public_key', dirname(DRUPAL_ROOT) . '/config/certs/public.key');
  $config->set('private_key', dirname(DRUPAL_ROOT) . '/config/certs/private.key');
  $config->save(TRUE);

  // Consumers come from config/.env.consumers.<environment>, where the
  // environment is set by CONSUMERS_ENV and defaults to development.
  try {
    // Delete default consumer.
    $default_consumer = \Drupal::entityTypeManager()
      ->getStorage('consumer')
      ->load(1);
    $default_consumer?->delete();

    // Load consumers environment. Exit if not available.
    $environment = getenv('CONSUMERS_ENV') ?: 'development';
    $env_path = dirname(DRUPAL_ROOT) . '/config/.env.consumers.' . $environment;
    if (!is_readable($env_path)) {
      throw new \RuntimeException(sprintf('%s file is not readable.', $env_path));
    }

    // Get local and development consumer info.
    $consumer_uuids = [];
    $consumer_redirects = [];
    $consumer_secrets = [];
    $lines = file($env_path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
      if (str_starts_with(trim($line), '#')) {
        continue;
      }
      [$name, $value] = explode('=', $line, 2);
      $name = trim($name);
      $value = trim($value);

      if (str_starts_with(trim($line), 'UUID')) {
        $consumer_uuids[$name] = $value;
      }
      elseif (str_starts_with(trim($line), 'REDIRECT')) {
        $consumer_redirects[$name] = $value;
      }
      elseif (str_starts_with(trim($line), 'SECRET')) {
        $consumer_secrets[$name] = $value;
      }
    }

    // Add consumers for creatives and organizations. The scopes are provided
    // as configuration by the creatives and organizations modules.
    $consumers = [
      'CREATIVE_LOCAL' => ['dd9ace1c-8879-45ae-b137-9cc06b4b5821', 'Creatives (local)', FALSE],
      'CREATIVE' => ['7f56f1d5-154f-42c1-b591-45e4e2fd235e', 'Creatives', TRUE],
      'ORGANIZATION_LOCAL' => ['ff5a1e31-557c-4c17-a7f5-a4a342d3cc19', 'Organizations (local)', TRUE],
      'ORGANIZATION' => ['63b60b9e-dbbc-4214-a520-f8cf4cab65da', 'Organizations', TRUE],
    ];
    foreach ($consumers as $key => [$uuid, $label, $is_default]) {
      if (!isset($consumer_uuids['UUID_' . $key], $consumer_redirects['REDIRECT_' . $key], $consumer_secrets['SECRET_' . $key])) {
        continue;
      }
      Consumer::create([
        'uuid' => $uuid,
        'client_id' => $consumer_uuids['UUID_' . $key],
        'label' => $label,
        'third_party' => FALSE,
        'is_default' => $is_default,
        'owner_id' => 1,
        'confidential' => TRUE,
        'secret' => $consumer_secrets['SECRET_' . $key],
        'grant_types' => [
          ['value' => 'authorization_code'],
          ['value' => 'refresh_token'],
        ],
        // The frontend is a first party client, so skip the consent form.
        'automatic_authorization' => TRUE,
        'remember_approval' => TRUE,
        'pkce' => FALSE,
        // 1 hour and 14 days.
        'access_token_expiration' => 3600,
        'refresh_token_expiration' => 1209600,
        'image_styles' => [
          ['target_id' => 'avatar'],
          ['target_id' => 'content'],
          ['target_id' => 'teaser'],
        ],
        'redirect' => $consumer_redirects['REDIRECT_' . $key],
      ])->save();
    }
  }
  catch (InvalidPluginDefinitionException | PluginNotFoundException | EntityStorageException | RuntimeException $e) {
    $variables = Error::decodeException($e);
    \Drupal::logger('youvo')
      ->info('Skipped consumer settings. %type: @message in %function (line %line of %file).', $variables);
  }
}
