<?php

/**
 * @file
 * Install, update and uninstall functions for the youvo_dummy module.
 */

use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
use Drupal\Component\Plugin\Exception\PluginNotFoundException;
use Drupal\Core\File\FileExists;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Utility\Error;
use Drupal\file\Entity\File;
use Drupal\file\FileInterface;

/**
 * Implements hook_install().
 */
function youvo_dummy_install(): void {
  module_set_weight('youvo_dummy', 1);
}

/**
 * Implements hook_site_install_finished().
 *
 * The order of the hook implementations does not follow the module weights
 * during the installation. Therefore, the dummy content is generated here in
 * an explicit order: Projects depend on creatives and organizations.
 *
 * The project events of the dummy content trigger hundreds of mails. The
 * global mailer policy skips them while generating, before they are built.
 *
 * The image styles of the dummy files are queued instead of being generated
 * when the process ends, which takes minutes with ImageMagick. The install
 * scripts process the queue.
 *
 * @see https://www.drupal.org/project/drupal/issues/2924549
 */
function youvo_dummy_site_install_finished(): void {
  $override_key = 'mailer_policy.mailer_policy._';
  $previous = $GLOBALS['config'][$override_key] ?? NULL;
  $GLOBALS['config'][$override_key]['configuration']['email_skip_sending'] = [
    'message' => 'Dummy content is being generated.',
  ];
  youvo_dummy_reset_policy($override_key);

  // The image style warmer keeps the settings it was created with, so the
  // override still applies when the process ends. It must be NULL, because an
  // empty array is merged into the configured styles.
  $warmer_key = 'image_style_warmer.settings';
  $previous_warmer = $GLOBALS['config'][$warmer_key] ?? NULL;
  $styles = \Drupal::config($warmer_key)->get('initial_image_styles');
  $GLOBALS['config'][$warmer_key]['initial_image_styles'] = NULL;
  $GLOBALS['config'][$warmer_key]['queue_image_styles'] = $styles;
  \Drupal::configFactory()->reset($warmer_key);

  try {
    $module_handler = \Drupal::moduleHandler();
    foreach (['creatives', 'organizations', 'academy', 'projects'] as $name) {
      $start = microtime(TRUE);
      $module_handler->loadInclude($name . '_dummy', 'install');
      ($name . '_dummy_generate_content')();
      // Shown by the install scripts, which run this hook via drush.
      if (PHP_SAPI === 'cli') {
        printf("  %s: %.1fs\n", $name, microtime(TRUE) - $start);
      }
    }
    // The registrations are dated by the first project logs of the creatives.
    creatives_dummy_log_registrations();
  }
  finally {
    // Restore overrides from settings.php.
    if ($previous === NULL) {
      unset($GLOBALS['config'][$override_key]);
    }
    else {
      $GLOBALS['config'][$override_key] = $previous;
    }
    youvo_dummy_reset_policy($override_key);
    if ($previous_warmer === NULL) {
      unset($GLOBALS['config'][$warmer_key]);
    }
    else {
      $GLOBALS['config'][$warmer_key] = $previous_warmer;
    }
    \Drupal::configFactory()->reset($warmer_key);
  }
}

/**
 * Drops cached copies of a mailer policy, so config overrides apply.
 */
function youvo_dummy_reset_policy(string $config_name): void {
  \Drupal::configFactory()->reset($config_name);
  \Drupal::entityTypeManager()->getStorage('mailer_policy')->resetCache();
}

/**
 * Returns the password field value for dummy users.
 *
 * Hashing is deliberately slow, so "password" is hashed once and stored as is
 * for every dummy user.
 */
function youvo_dummy_get_password(): array {
  $hash = &drupal_static(__FUNCTION__);
  $hash ??= \Drupal::service('password')->hash('password');
  return ['value' => $hash, 'pre_hashed' => TRUE];
}

/**
 * Returns skills array.
 */
function youvo_dummy_get_random_skills(): array {
  $skills = [];
  $skills_select = [1, 2, 3, 4, 5, 6];
  shuffle($skills_select);
  $skills_select = array_slice($skills_select, 0, random_int(1, 3));
  foreach ($skills_select as $skill) {
    $skills[] = ['target_id' => $skill];
  }
  return $skills;
}

/**
 * Returns skills array.
 */
function youvo_dummy_get_random_causes(): array {
  $causes = [];
  $causes_select = [];
  try {
    /** @var \Drupal\taxonomy\Entity\Term[] $causes_select */
    $causes_select = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadByProperties(['vid' => 'causes']);
  }
  catch (InvalidPluginDefinitionException | PluginNotFoundException $e) {
    $variables = Error::decodeException($e);
    \Drupal::logger('youvo_dummy')
      ->error('An error occurred while loading taxonomy terms. %type: @message in %function (line %line of %file).', $variables);
  }
  shuffle($causes_select);
  $causes_select = array_slice($causes_select, 0, random_int(0, 2));
  foreach ($causes_select as $cause) {
    $causes[] = ['target_id' => $cause->id()];
  }
  return $causes;
}

/**
 * Returns stock image file.
 *
 * @param string $path
 *   Path to image.
 * @param string $file_name
 *   File name of image.
 *
 * @return \Drupal\file\FileInterface
 *   Image file.
 */
function youvo_dummy_get_image_by_path(string $path, string $file_name): FileInterface {
  return youvo_dummy_get_file('youvo_dummy', trim($path, '/') . '/' . $file_name);
}

/**
 * Returns the file entity for a file shipped with a dummy module.
 *
 * The file is copied to public://dummy/<module>/<path> once. Later calls reuse
 * the file entity, and a file left over from an earlier install is not copied
 * again. Throws when the file cannot be put in place.
 *
 * @param string $module
 *   The dummy module shipping the file.
 * @param string $path
 *   Path of the file relative to the module.
 *
 * @return \Drupal\file\FileInterface
 *   The file entity.
 */
function youvo_dummy_get_file(string $module, string $path): FileInterface {
  $uri = 'public://dummy/' . $module . '/' . $path;

  /** @var \Drupal\file\FileInterface[] $files */
  $files = \Drupal::entityTypeManager()->getStorage('file')->loadByProperties(['uri' => $uri]);
  if ($file = reset($files)) {
    return $file;
  }

  // Fail loudly: a file entity without its file breaks image styles later.
  if (!file_exists($uri)) {
    /** @var \Drupal\Core\File\FileSystemInterface $file_system */
    $file_system = \Drupal::service('file_system');
    $directory = dirname($uri);
    if (!$file_system->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
      throw new \RuntimeException(sprintf('Unable to create the dummy directory %s (%s).', $directory, $file_system->realpath($directory) ?: 'no real path'));
    }
    $source = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.module')->getPath($module) . '/' . $path;
    $file_system->copy($source, $uri, FileExists::Replace);
    clearstatcache();
    if (!file_exists($uri)) {
      throw new \RuntimeException(sprintf('Copied %s to %s, but the file is missing (%s).', $source, $uri, $file_system->realpath($uri) ?: 'no real path'));
    }
  }

  $file = File::create([
    'uri' => $uri,
    'uid' => 1,
    'status' => 1,
  ]);
  $file->save();

  return $file;
}

/**
 * Returns random creative id.
 *
 * @param array $creative_ids
 *   Array of creative ids.
 *
 * @return int
 *   Random creative id.
 */
function youvo_dummy_get_random_creative(array $creative_ids): int {
  if (!empty($creative_ids)) {
    return $creative_ids[array_rand($creative_ids)];
  }
  return 0;
}

/**
 * Returns random organization id.
 *
 * @param array $organization_ids
 *   Array of organization ids.
 *
 * @return int
 *   Random organization id.
 */
function youvo_dummy_get_random_organization(array $organization_ids): int {
  if (!empty($organization_ids)) {
    return $organization_ids[array_rand($organization_ids)];
  }
  return 0;
}
