<?php

/**
 * @file
 * Install, update and uninstall functions for the organizations_dummy module.
 */

use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
use Drupal\Component\Plugin\Exception\PluginNotFoundException;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Utility\Error;
use Drupal\creatives\Entity\Creative;
use Drupal\creatives\Event\CreativeRegisterEvent;
use Drupal\logbook\LogInterface;
use Drupal\user\Entity\User;
use Faker\Factory;

/**
 * Implements hook_install().
 */
function creatives_dummy_install(): void {
  module_set_weight('creatives_dummy', 2);
}

/**
 * Generates the dummy content.
 *
 * Called by youvo_dummy_site_install_finished() to guarantee the order.
 */
function creatives_dummy_generate_content(): void {

  // Object for random content.
  $faker = Factory::create('de_DE');
  $faker->seed(96886);
  $images_names = ['anne', 'paula', 'frank'];
  $schools = [
    'Fachschule',
    'Hochschule',
    'Akademie',
    'Fachhochschule',
    'Universität',
  ];

  // Iterate some dummy creatives.
  for ($i = 1; $i <= 31; $i++) {

    // Values for creative user.
    shuffle($images_names);
    $image_file = youvo_dummy_get_image_by_path('/img/test_images/portrait/', $images_names[0] . '.jpg');
    $roles = [];
    if ($i == 1) {
      $firstname = 'Fredolina';
      $mail = 'fred@youvo.org';
      $roles = ['creative', 'editor', 'manager'];
    }
    else {
      $firstname = $faker->unique()->firstName();
      $mail = str_replace(' ', '_', strtolower(iconv("utf-8", "ascii//TRANSLIT", $firstname))) . '@example.com';
      $roles[] = 'creative';
      if (rand(1, 100) < 20) {
        $roles[] = 'manager';
      }
    }

    $portfolio = [];
    for ($j = 0; $j <= rand(0, 5); $j++) {
      $portfolio[] = $faker->url();
    }

    $values = [
      'type' => 'user',
      'name' => $mail,
      'mail' => $mail,
      'roles' => $roles,
      'pass' => youvo_dummy_get_password(),
      'status' => 1,
      'field_avatar' => [
        'target_id' => $image_file->id(),
        'alt' => $faker->text(10),
      ],
      'field_city' => $faker->optional(0.8)->city(),
      'field_name' => $firstname . ' ' . $faker->lastName(),
      'field_position' => $faker->optional(0.8)->jobTitle(),
      'field_about' => $faker->optional(0.9)->text(400),
      'field_skills' => youvo_dummy_get_random_skills(),
      'field_portfolio' => $portfolio,
      'field_phone' => $faker->optional()->phoneNumber(),
      'field_url' => 'https://www.' . $faker->optional(0.8)->domainName(),
      'field_education' => $faker->optional(0.8)
        ->passthrough($faker->randomElement($schools) . ' ' . $faker->city()),
      'field_jobs' => $faker->boolean(),
      'field_public_profile' => $faker->boolean(),
      'field_newsletter' => $faker->boolean(),
    ];

    // Create creative.
    $creative = User::create($values);
    try {
      $creative->save();
    }
    catch (EntityStorageException $e) {
      $variables = Error::decodeException($e);
      \Drupal::logger('youvo')
        ->error('An error occurred while creating dummy creative. %type: @message in %function (line %line of %file).', $variables);
    }
  }

  // Delete user with ID 14 for legacy user.
  try {
    if ($account = \Drupal::entityTypeManager()
      ->getStorage('user')->load(14)) {
      $account->delete();
    }
  }
  catch (InvalidPluginDefinitionException | PluginNotFoundException | EntityStorageException $e) {
    $variables = Error::decodeException($e);
    \Drupal::logger('youvo')
      ->error('An error occurred while deleting dummy creative. %type: @message in %function (line %line of %file).', $variables);
  }
}

/**
 * Logs the registrations of the creatives.
 *
 * Called by youvo_dummy_site_install_finished() after the projects, so a
 * creative registers a few days before the first log with them, mostly an
 * application. Creatives without such a log register some time in the year of
 * the projects. The mail with the link is skipped while the dummy content is
 * generated.
 */
function creatives_dummy_log_registrations(): void {
  $current_time = \Drupal::time()->getRequestTime();
  $one_year_ago = $current_time - 31536000;
  /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher */
  $event_dispatcher = \Drupal::service('event_dispatcher');
  try {
    $log_storage = \Drupal::entityTypeManager()->getStorage('log');
    $creative_ids = \Drupal::entityQuery('user')
      ->accessCheck(FALSE)
      ->condition('roles', 'creative')
      ->execute();
    foreach (Creative::loadMultiple($creative_ids) as $id => $creative) {
      $first = $log_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('creatives', $id)
        ->sort('created')
        ->range(0, 1)
        ->execute();
      $first_log = $first ? $log_storage->load(reset($first)) : NULL;
      if ($first_log instanceof LogInterface) {
        $registered = max($one_year_ago, $first_log->getCreatedTime() - random_int(86400, 14 * 86400));
      }
      else {
        $registered = random_int($one_year_ago, $current_time);
      }
      $creative->set('created', $registered)->save();
      $event_dispatcher->dispatch(new CreativeRegisterEvent($creative, 'https://www.youvo.org', $registered));
    }
  }
  catch (InvalidPluginDefinitionException | PluginNotFoundException | EntityStorageException $e) {
    $variables = Error::decodeException($e);
    \Drupal::logger('youvo')
      ->error('An error occurred while logging dummy registrations. %type: @message in %function (line %line of %file).', $variables);
  }
}
