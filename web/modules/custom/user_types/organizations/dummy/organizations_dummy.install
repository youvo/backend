<?php

/**
 * @file
 * Install, update and uninstall functions for the organizations_dummy module.
 */

use Drupal\Component\EventDispatcher\Event;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Utility\Error;
use Drupal\creatives\Entity\Creative;
use Drupal\logbook\LogInterface;
use Drupal\organizations\Entity\Organization;
use Drupal\organizations\Event\OrganizationDisbandEvent;
use Drupal\organizations\Event\OrganizationManageEvent;
use Drupal\projects\Event\ProjectInviteEvent;
use Drupal\projects\ProjectInterface;
use Faker\Factory;
use Symfony\Component\EventDispatcher\EventDispatcherInterface;

/**
 * Implements hook_install().
 */
function organizations_dummy_install(): void {
  module_set_weight('organizations_dummy', 3);
}

/**
 * Generates the dummy content.
 *
 * Called by youvo_dummy_site_install_finished() to guarantee the order.
 */
function organizations_dummy_generate_content(): void {

  // Object for random content.
  $faker = Factory::create('de_DE');
  $faker->seed(96886);

  // Get possible managers.
  $manager_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('roles', 'manager')
    ->condition('uid', 1, '!=')
    ->execute();

  // Create some organizations.
  for ($i = 1; $i <= 20; $i++) {

    // Get field values.
    $image_file = youvo_dummy_get_image_by_path('/img/test_images/organizations/', 'test.jpg');
    $causes = youvo_dummy_get_random_causes();
    $portfolio = [];
    for ($j = 0; $j <= rand(0, 5); $j++) {
      $portfolio[] = $faker->url();
    }
    $firstname = $faker->unique()->firstName();
    $mail = str_replace(' ', '_', strtolower(iconv("utf-8", "ascii//TRANSLIT", $firstname))) . '@example.org';
    $name_extension = $faker->optional(0.7)
      ->randomElement([' e.V.', ' gUG', ' Verein', ' GbR', ' gGmbH']) ?: '';
    $organization_name = ucwords($faker->words(3, TRUE));
    $short_name = explode(' ', $organization_name);
    $short_name = array_map(fn ($s) => substr($s, 0, rand(3, 10)), $short_name);
    $short_name = implode('', $short_name) . $name_extension;

    // Values for organization user.
    $values = [
      'field_name' => $organization_name . $name_extension,
      'field_short_name' => $short_name,
      'field_url' => 'https://www.' . $faker->domainName(),
      'field_aim' => $faker->text(80),
      'field_about' => $faker->text(600),
      'field_causes' => $causes,
      'field_count_volunteer' => $faker->numberBetween(5, 20),
      'field_count_fulltime' => $faker->numberBetween(1, 5),
      'field_contact' => $firstname . ' ' . $faker->lastName(),
      'field_phone' => $faker->phoneNumber(),
      'field_reachability' => $faker->text(80),
      'field_referral' => $faker->text(),
      'field_street' => $faker->streetAddress(),
      'field_zip' => $faker->postcode(),
      'field_city' => $faker->city(),
      'field_country' => $faker->optional(0.2)->country(),
      'field_avatar' => [
        'target_id' => $image_file->id(),
        'alt' => $faker->text(50),
      ],
      'field_budget' => $faker->text(),
      'field_publicity' => $faker->optional()->text(),
      'field_portfolio' => $faker->optional(0.8)->passthrough($portfolio),
      'name' => $mail,
      'mail' => $mail,
      'type' => 'organization',
      'pass' => youvo_dummy_get_password(),
      'status' => 1,
    ];

    // Create organization.
    $organization = Organization::create($values);

    if ($i <= 15) {
      // Always assign a manager to non-prospect organizations.
      $organization->get('field_manager')
        ->appendItem($faker->randomElement($manager_ids));
      $organization->addRole('organization');
    }
    else {
      // A creative manages some of the prospects, to invite them. Not drawn
      // with Faker, which would change the rest of the content.
      if ($i <= 18) {
        $prospect_managers = array_values($manager_ids);
        $organization->get('field_manager')
          ->appendItem($prospect_managers[random_int(0, count($prospect_managers) - 1)]);
      }
      $organization->addRole('prospect');
    }

    try {
      $organization->save();
    }
    catch (EntityStorageException $e) {
      $variables = Error::decodeException($e);
      \Drupal::logger('youvo')
        ->error('An error occurred while creating dummy organization. %type: @message in %function (line %line of %file).', $variables);
    }
  }
}

/**
 * Logs how the organizations got their managers.
 *
 * Called by youvo_dummy_site_install_finished() after the projects, so the
 * manager takes over an organization a few days before its first log. Some
 * organizations had another manager before, who gave them up. Organizations
 * without a log get their manager some time in the year of the projects. The
 * organizations are dated to register before that, with a last login and
 * access after. Prospects register with their project, and the managed ones
 * are invited with it.
 */
function organizations_dummy_log_management(): void {
  $current_time = \Drupal::time()->getRequestTime();
  $one_year_ago = $current_time - 31536000;
  $day = 86400;
  /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher */
  $event_dispatcher = \Drupal::service('event_dispatcher');
  $entity_type_manager = \Drupal::entityTypeManager();

  $manager_ids = array_values(\Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('roles', 'manager')
    ->condition('uid', 1, '!=')
    ->execute());
  $organization_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('type', 'organization')
    ->condition('roles', 'organization')
    ->execute();

  foreach (Organization::loadMultiple($organization_ids) as $id => $organization) {
    $manager = $organization->getManager();
    if (!$manager instanceof Creative) {
      continue;
    }
    $first_managed = NULL;

    $first_log = organizations_dummy_first_log_time((int) $id);
    $managed = $first_log !== NULL
      ? $first_log - random_int($day, 14 * $day)
      : random_int($one_year_ago, $current_time);

    // Some organizations had another manager, who gave them up.
    $others = array_values(array_diff($manager_ids, [$manager->id()]));
    if ($others && random_int(1, 5) === 1) {
      $previous = Creative::load($others[random_int(0, count($others) - 1)]);
      if ($previous instanceof Creative) {
        $disbanded = $managed - random_int($day, 14 * $day);
        $started = $disbanded - random_int(30 * $day, 90 * $day);
        organizations_dummy_dispatch_as($previous, new OrganizationManageEvent($organization, $previous, $started), $event_dispatcher);
        organizations_dummy_dispatch_as($previous, new OrganizationDisbandEvent($organization, $previous, $disbanded), $event_dispatcher);
        $first_managed = $started;
      }
    }

    organizations_dummy_dispatch_as($manager, new OrganizationManageEvent($organization, $manager, $managed), $event_dispatcher);

    // The organization registered a few days before it got its first manager.
    youvo_dummy_set_account_times((int) $id, ($first_managed ?? $managed) - random_int($day, 7 * $day));
  }

  // Prospect organizations registered recently, together with their project.
  // A creative takes over some of them and invites them with the project.
  $prospect_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('type', 'organization')
    ->condition('roles', 'prospect')
    ->execute();
  foreach (Organization::loadMultiple($prospect_ids) as $id => $prospect) {
    $proposed = organizations_dummy_first_log_time((int) $id) ?? random_int($current_time - 30 * $day, $current_time - $day);
    youvo_dummy_set_account_times((int) $id, $proposed - random_int(60, 600));

    $manager = $prospect->getManager();
    if (!$manager instanceof Creative) {
      continue;
    }
    $managed = min($current_time, $proposed + random_int(3600, 5 * $day));
    organizations_dummy_dispatch_as($manager, new OrganizationManageEvent($prospect, $manager, $managed), $event_dispatcher);
    $projects = $entity_type_manager->getStorage('project')->loadByProperties(['uid' => $id]);
    foreach ($projects as $project) {
      if ($project instanceof ProjectInterface && $project->lifecycle()->isDraft()) {
        $invited = min($current_time, $managed + random_int(3600, 3 * $day));
        organizations_dummy_dispatch_as($manager, new ProjectInviteEvent($project, $invited), $event_dispatcher);
      }
    }
  }
}

/**
 * Gets the time of the first log of an organization or of its projects.
 */
function organizations_dummy_first_log_time(int $id): ?int {
  $entity_type_manager = \Drupal::entityTypeManager();
  $log_storage = $entity_type_manager->getStorage('log');
  $project_ids = $entity_type_manager->getStorage('project')->getQuery()
    ->accessCheck(FALSE)
    ->condition('uid', $id)
    ->execute();
  $query = $log_storage->getQuery()->accessCheck(FALSE);
  $involved = $query->orConditionGroup()->condition('organization', $id);
  if ($project_ids) {
    $involved->condition('project', $project_ids, 'IN');
  }
  $first = $query->condition($involved)->sort('created')->range(0, 1)->execute();
  $first_log = $first ? $log_storage->load(reset($first)) : NULL;
  return $first_log instanceof LogInterface ? $first_log->getCreatedTime() : NULL;
}

/**
 * Dispatches an event as a user, who becomes the author of its log.
 */
function organizations_dummy_dispatch_as(AccountInterface $account, Event $event, EventDispatcherInterface $event_dispatcher): void {
  /** @var \Drupal\Core\Session\AccountSwitcherInterface $account_switcher */
  $account_switcher = \Drupal::service('account_switcher');
  $account_switcher->switchTo($account);
  try {
    $event_dispatcher->dispatch($event);
  }
  finally {
    $account_switcher->switchBack();
  }
}
