<?php

/**
 * @file
 * Custom module which handles business logic for organization entities.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\organizations\Access\OrganizationFieldAccess;
use Drupal\organizations\Entity\Organization;
use Drupal\organizations\Plugin\TopBarItem\OrganizationPageContext;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function organizations_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['user']['organization'])) {
    $bundles['user']['organization']['class'] = Organization::class;
  }
}

/**
 * Implements hook_entity_field_access().
 */
function organizations_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  $entity = $items?->getEntity();
  if ($entity instanceof Organization) {
    return OrganizationFieldAccess::checkFieldAccess($entity, $operation, $field_definition, $account);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_theme().
 */
function organizations_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'organization_invite_password_form' => [
      'render element' => 'form',
    ],
  ];
}

/**
 * Implements hook_top_bar_item_alter().
 *
 * The top bar shows the name of an organization, as its page title does.
 */
function organizations_top_bar_item_alter(array &$definitions): void {
  if (isset($definitions['page_context'])) {
    $definitions['page_context']['class'] = OrganizationPageContext::class;
  }
}
