<?php

/**
 * @file
 * Custom module which handles business logic for user types.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\user\UserInterface;
use Drupal\user_types\Plugin\TopBarItem\UserTypePageContext;
use Drupal\user_types\UserTypeAccessControlHandler;

/**
 * Implements hook_entity_type_build().
 */
function user_types_entity_type_build(array &$entity_types): void {
  // Be careful here, because user_bundle_entity_type_build() already alters the
  // entity handlers.
  $entity_types['user']->setHandlerClass('access', UserTypeAccessControlHandler::class);
}

/**
 * Implements hook_views_data_alter().
 */
function user_types_views_data_alter(array &$data): void {
  $data['users_field_data']['user_returned'] = [
    'title' => t('Returned'),
    'help' => t('Whether the user accessed the site at least a day after registering.'),
    'real field' => 'uid',
    'filter' => ['id' => 'user_returned', 'real field' => 'uid', 'type' => 'yes-no'],
  ];
  foreach ([
    'user_created_range' => [t('Registered between'), 'created'],
    'user_access_range' => [t('Last access between'), 'access'],
  ] as $key => [$title, $field]) {
    $data['users_field_data'][$key] = [
      'title' => $title,
      'help' => t('Limits the users to a range of days, either end may stay open.'),
      'real field' => $field,
      'filter' => ['id' => 'user_date_range', 'real field' => $field],
    ];
  }
}

/**
 * Implements hook_entity_operation().
 *
 * User lists offer the profile page next to edit and delete, which core
 * lists for users.
 */
function user_types_entity_operation(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL): array {
  if (!$entity instanceof UserInterface) {
    return [];
  }
  $access = $entity->access('view', NULL, TRUE);
  $cacheability?->addCacheableDependency($access);
  if (!$access->isAllowed()) {
    return [];
  }
  return [
    'view' => [
      'title' => t('View'),
      'url' => $entity->toUrl(),
      // Between edit and delete.
      'weight' => 20,
    ],
  ];
}

/**
 * Implements hook_top_bar_item_alter().
 *
 * The top bar shows the name of a creative or an organization, as the title
 * of its page does.
 */
function user_types_top_bar_item_alter(array &$definitions): void {
  if (isset($definitions['page_context'])) {
    $definitions['page_context']['class'] = UserTypePageContext::class;
  }
}
