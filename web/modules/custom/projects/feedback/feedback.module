<?php

/**
 * @file
 * Custom module which handles business logic for feedback.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\feedback\Access\FeedbackFieldAccess;
use Drupal\feedback\FeedbackInterface;

/**
 * Implements hook_entity_field_access().
 */
function feedback_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  $entity = $items?->getEntity();
  if ($entity instanceof FeedbackInterface) {
    return FeedbackFieldAccess::checkFieldAccess($entity, $operation, $field_definition, $account);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function feedback_form_field_config_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\field_ui\Form\FieldConfigEditForm $form_object */
  $form_object = $form_state->getFormObject();
  /** @var Drupal\field\Entity\FieldConfig $field */
  $field = $form_object->getEntity();
  if ($form['#entity'] instanceof FeedbackInterface && $field->getType() === 'boolean') {
    unset($form['default_value']);
  }
}
