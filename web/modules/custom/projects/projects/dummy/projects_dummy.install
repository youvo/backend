<?php

/**
 * @file
 * Install, update and uninstall functions for the projects_dummy module.
 */

use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\File\FileExists;
use Drupal\Core\Utility\Error;
use Drupal\creatives\Entity\Creative;
use Drupal\feedback\Entity\Feedback;
use Drupal\feedback\Event\FeedbackCompleteEvent;
use Drupal\field\FieldConfigInterface;
use Drupal\file\FileInterface;
use Drupal\organizations\Entity\Organization;
use Drupal\projects\Entity\Project;
use Drupal\projects\Entity\ProjectComment;
use Drupal\projects\Event\ProjectApplyEvent;
use Drupal\projects\Event\ProjectCompleteEvent;
use Drupal\projects\Event\ProjectDeclineEvent;
use Drupal\projects\Event\ProjectMediateEvent;
use Drupal\projects\Event\ProjectNotifyEvent;
use Drupal\projects\Event\ProjectPublishEvent;
use Drupal\projects\Event\ProjectSubmitEvent;
use Drupal\projects\ProjectDeclineReason;
use Drupal\projects\ProjectInterface;
use Drupal\user\Entity\User;
use Faker\Factory;
use Faker\Generator;

/**
 * Implements hook_install().
 */
function projects_dummy_install(): void {
  module_set_weight('projects_dummy', 3);
}

/**
 * Generates the dummy content.
 *
 * Called by youvo_dummy_site_install_finished() to guarantee the order.
 */
function projects_dummy_generate_content(): void {

  // Initialize user IDs.
  $creative_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('roles', 'creative')
    ->condition('uid', 1, '!=')
    ->execute();
  // Prospects have no manager, so any manager declines their proposals.
  $manager_ids = array_values(\Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('roles', 'manager')
    ->condition('uid', 1, '!=')
    ->execute());
  $organization_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('type', 'organization')
    ->condition('roles', 'organization')
    ->execute();

  // Object for random content.
  $faker = Factory::create('de_DE');
  $faker->seed(96886);
  // The feedback has its own generator, so the projects stay as they were.
  $feedback_faker = Factory::create('de_DE');
  $feedback_faker->seed(43511);
  // So do the edits of the projects.
  $edit_faker = Factory::create('de_DE');
  $edit_faker->seed(27183);

  // Array of cycle states.
  $lifecycle_states = [
    'draft',
    'pending',
    'open',
    'ongoing',
    'completed',
  ];

  // Some time to use.
  $current_time = \Drupal::time()->getRequestTime();

  // Total projects. The gaps between them are drawn first and counted back
  // from now, so the newest project was created a day ago.
  $total = 100;
  $max_created_increment = 31536000 / $total;
  $created_increments = [];
  for ($i = 1; $i <= $total; $i++) {
    $created_increments[$i] = random_int(min(86400, $max_created_increment), $max_created_increment);
  }
  $created = $current_time - 86400 - array_sum($created_increments);

  // Organization contacts and manager storage.
  $contacts = [];
  $managers = [];

  /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher */
  $event_dispatcher = \Drupal::service('event_dispatcher');

  // The images are attached on create. Without active updating, every later
  // save makes filefield_paths log a notice about the file it skips; with it,
  // a file already in place passes silently.
  $image_field = 'field.field.project.project.field_image';
  $GLOBALS['config'][$image_field]['third_party_settings']['filefield_paths']['active_updating'] = TRUE;
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  // Create random content.
  for ($i = 1; $i <= $total; $i++) {

    // Get field values.
    $skills = youvo_dummy_get_random_skills();

    // Increase created time randomly.
    $created += $created_increments[$i];

    // A project has at most 17 steps up to its last feedback: submit,
    // publish, five applications, mediate, complete, six feedbacks and two
    // edits. They take up to a week each, less for recent projects, so no step
    // lies in the future.
    $step_max = max(3600, min(7 * 86400, intdiv($current_time - $created, 17)));

    // Choose a random final state (not draft, since all start as draft).
    $lifecycle_states = [
      'draft',
      'pending',
      'open',
      'ongoing',
      'completed',
      'declined',
    ];
    $final_state = $faker->randomElement($lifecycle_states);

    // Completed and declined projects have a deadline in the past, since the
    // manager rules ignore them. The deadline of all other projects is mostly
    // comfortable, so that only a few are upcoming or overdue.
    if (in_array($final_state, ['completed', 'declined'])) {
      $rnd_time = random_int($created, max($created, min($created + 1209600, $current_time)));
    }
    else {
      $deadline_roll = random_int(1, 100);
      $rnd_time = match (TRUE) {
        // Overdue (critical).
        $deadline_roll <= 5 => $current_time - random_int(1, 30) * 86400,
        // Upcoming within two weeks (warning).
        $deadline_roll <= 20 => $current_time + random_int(1, 13) * 86400,
        // No deadline problems.
        default => $current_time + random_int(21, 120) * 86400,
      };
    }
    $deadline = \Drupal::service('date.formatter')
      ->format($rnd_time, 'custom', 'Y-m-d');

    // Get organization with contact and manager.
    $oid = youvo_dummy_get_random_organization($organization_ids);
    if (!isset($contacts[$oid])) {
      $organization = User::load($oid);
      $contact = $organization->get('field_contact')->value;
      $contacts[$oid] = $contact;
      /** @var \Drupal\Core\Field\EntityReferenceFieldItemList $manager_field */
      $manager_field = $organization->get('field_manager');
      $manager_user = $manager_field->referencedEntities();
      $manager_user = !empty($manager_user) ? array_shift($manager_user) : NULL;
      $manager = $manager_user instanceof User ? $manager_user->id() : 0;
      $managers[$oid] = $manager;
    }
    else {
      $contact = $contacts[$oid];
      $manager = $managers[$oid];
    }

    // Declined projects are drafts of prospect organizations or pending.
    $path_state = $final_state;
    if ($final_state === 'declined') {
      $path_state = Organization::load($oid)->hasRoleProspect() ? 'draft' : 'pending';
    }

    $values = [
      'type' => 'project',
      'title' => ucwords($faker->words(4, TRUE)),
      'body' => [
        'value' => rtrim($faker->text(600)),
        'summary' => rtrim($faker->text(300)),
      ],
      'langcode' => 'de',
      'created' => $created,
      'uid' => $oid,
      'status' => 1,
      'promote' => in_array($final_state, ['open', 'completed']) && $faker->boolean(),
      'field_allowance' => $faker->boolean(),
      'field_contact' => $contact,
      'field_workload' => random_int(1, 5),
      'field_deadline' => $deadline,
      'field_city' => $faker->city(),
      'field_material' => $faker->text(100),
      'field_appreciation' => $faker->text(100),
      'field_skills' => $skills,
      'field_image_copyright' => $faker->optional()->name(),
      'field_lifecycle' => 'draft',
      'field_local' => $faker->boolean(),
      // The image is there from the start, so the revisions don't show it as
      // added by a later edit.
      'field_image' => [
        'target_id' => projects_dummy_get_stock_image($i)->id(),
        'alt' => $faker->text(50),
      ],
    ];

    // The edits along the lifecycle end with these values, so the project
    // starts with earlier ones of the edited fields.
    $edits = projects_dummy_plan_edits($path_state, (bool) $manager, $edit_faker);
    $project = Project::create(projects_dummy_earlier_values($values, $edits, $edit_faker));

    try {
      // Each step runs as the user who does it in the app, so the logs get
      // their authors.
      projects_dummy_as($oid, fn () => $project->save());
      $transition_time = $created;
      $participant_entities = [];
      $transition_increment = random_int(min(86400, $step_max), $step_max);
      projects_dummy_edit($project, $edits, 'draft', $values, $oid, $manager, $transition_time, $step_max);
      // Always start in draft. Now transition up to the random final state
      // using events.
      if (in_array($path_state, ['pending', 'open', 'ongoing', 'completed'])) {
        $transition_time += $transition_increment;
        projects_dummy_as($oid, fn () => $event_dispatcher->dispatch(new ProjectSubmitEvent($project, $transition_time)));
        projects_dummy_edit($project, $edits, 'pending', $values, $oid, $manager, $transition_time, $step_max);
      }
      if (in_array($path_state, ['open', 'ongoing', 'completed'])) {
        $transition_time += $transition_increment;
        projects_dummy_as($manager, fn () => $event_dispatcher->dispatch(new ProjectPublishEvent($project, $transition_time)));
        // Add applicants after publish. Ensure at least one applicant.
        // The manager must not apply. Exclude them before picking, otherwise
        // the manager may be the only drawn applicant and the project would
        // have no creative participant to mediate with.
        $eligible_ids = array_values(array_diff($creative_ids, [$manager]));
        shuffle($eligible_ids);
        $num_applicants = random_int(1, min(5, count($eligible_ids)));
        $applicants = array_slice($eligible_ids, 0, $num_applicants);
        $actual_applicants = [];
        foreach ($applicants as $applicant_id) {
          $applicant = Creative::load($applicant_id);
          if ($applicant) {
            $transition_time += random_int(min(86400, $step_max), $step_max);
            $apply_event = new ProjectApplyEvent($project, $applicant, $transition_time);
            $apply_event->setMessage($faker->sentence());
            projects_dummy_as((int) $applicant_id, fn () => $event_dispatcher->dispatch($apply_event));
            $actual_applicants[] = $applicant_id;
          }
        }
        projects_dummy_edit($project, $edits, 'open', $values, $oid, $manager, $transition_time, $step_max);
      }
      if (in_array($path_state, ['ongoing', 'completed'])) {
        $transition_time += $transition_increment;
        // Add participants with 'Creative' task before mediate.
        // Only select participants from actual applicants.
        $participant_ids = [];
        if (!empty($actual_applicants)) {
          $num_participants = random_int(1, count($actual_applicants));
          $participant_ids = array_slice($actual_applicants, 0, $num_participants);
        }
        $participant_entities = [];
        foreach ($participant_ids as $pid) {
          $user = Creative::load($pid);
          if ($user) {
            $participant_entities[] = $user;
          }
        }
        $mediate_event = new ProjectMediateEvent($project, $transition_time);
        $mediate_event->setCreatives($participant_entities);
        projects_dummy_as($manager, fn () => $event_dispatcher->dispatch($mediate_event));
        projects_dummy_edit($project, $edits, 'mediated', $values, $oid, $manager, $transition_time, $step_max);
      }
      if ($final_state === 'completed') {
        $transition_time += $transition_increment;
        // Not drawn with Faker, which would change the rest of the content.
        $completers = array_merge([$oid, $manager], array_map(static fn ($creative) => (int) $creative->id(), $participant_entities));
        $completer = $completers[random_int(0, count($completers) - 1)];
        [$result_files, $result_links] = projects_dummy_get_results($project);
        $complete_event = new ProjectCompleteEvent($project, $transition_time);
        // The files are attached after the feedback, see below.
        $complete_event->setLinks($result_links);
        projects_dummy_as($completer, fn () => $event_dispatcher->dispatch($complete_event));
      }
      if ($final_state === 'declined') {
        $transition_time += $transition_increment;
        $decline_event = new ProjectDeclineEvent($project, $transition_time);
        $decline_event->setReason($faker->randomElement(ProjectDeclineReason::cases()));
        $decliner = $manager ?: $manager_ids[random_int(0, count($manager_ids) - 1)];
        projects_dummy_as((int) $decliner, fn () => $event_dispatcher->dispatch($decline_event));
      }
      // Not drawn with Faker, which would change the rest of the content.
      if ($final_state === 'draft' && $manager && random_int(1, 2) === 1) {
        $transition_time += $transition_increment;
        projects_dummy_as($manager, fn () => $event_dispatcher->dispatch(new ProjectNotifyEvent($project, $transition_time)));
      }
      // Set the changed value to the last event timestamp and save. Syncing
      // keeps this save out of the revisions and the change log.
      $project->set('changed', $transition_time);
      $project->setSyncing(TRUE);
      $project->save();
      $project->setSyncing(FALSE);
      if ($final_state === 'completed') {
        projects_dummy_complete_feedbacks($project, $participant_entities, $transition_time, $step_max, $feedback_faker);
        // Each feedback saves the result again with its comment, and
        // filefield_paths logs a notice per attached file on every later save.
        // So the files are attached in the last save of the result.
        $project->getResult()->setFiles($result_files)->save();
      }
    }
    catch (EntityStorageException $e) {
      $variables = Error::decodeException($e);
      \Drupal::logger('youvo')
        ->error('An error occurred while creating dummy projects. %type: @message in %function (line %line of %file).', $variables);
    }
  }

  // Create shell projects for prospect organizations.
  $prospect_ids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('type', 'organization')
    ->condition('roles', 'prospect')
    ->execute();

  foreach ($prospect_ids as $prospect_id) {

    // Create node with random information.
    $project = Project::create([
      'type' => 'project',
      'title' => ucwords($faker->words(4, TRUE)),
      'body' => [
        'value' => rtrim($faker->text(600)),
        'summary' => rtrim($faker->text(300)),
      ],
      'langcode' => 'de',
      'uid' => $prospect_id,
      // A prospect proposes its project when it registers, so its
      // registration is dated by this project later.
      'created' => random_int($current_time - 30 * 86400, $current_time - 86400),
      'field_lifecycle' => 'draft',
      'status' => 1,
      'promote' => 0,
    ]);

    try {
      projects_dummy_as((int) $prospect_id, fn () => $project->save());
    }
    catch (EntityStorageException $e) {
      $variables = Error::decodeException($e);
      \Drupal::logger('youvo')
        ->error('An error occurred while creating dummy projects. %type: @message in %function (line %line of %file).', $variables);
    }
  }

  unset($GLOBALS['config'][$image_field]);
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Returns stock image file.
 *
 * @param int $i
 *   Iteration index.
 *
 * @return \Drupal\file\FileInterface
 *   Image file.
 */
function projects_dummy_get_stock_image(int $i): FileInterface {
  $index = sprintf('%02d', (($i - 1) % 12) + 1);
  return youvo_dummy_get_file('projects_dummy', 'img/' . $index . '.jpg');
}

/**
 * Returns the results of a completed project, as the complete form sends them.
 *
 * Each result is an image or a link with a description. The images are copies
 * of the stock images, because the result field moves its files into the
 * folder of the project. Not drawn with Faker, which would change the rest of
 * the content.
 *
 * @param \Drupal\projects\ProjectInterface $project
 *   The completed project.
 *
 * @return array
 *   The files and the links, in the shape of the complete event.
 */
function projects_dummy_get_results(ProjectInterface $project): array {
  $file_descriptions = ['Logo', 'Flyer', 'Plakat', 'Styleguide', 'Social-Media-Vorlagen'];
  $link_descriptions = ['Website', 'Imagefilm', 'Online-Galerie', 'Präsentation'];
  $slug = trim(preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($project->getTitle())), '-');
  /** @var \Drupal\file\FileRepositoryInterface $file_repository */
  $file_repository = \Drupal::service('file.repository');
  $files = [];
  $links = [];
  $count = random_int(1, 4);
  for ($delta = 0; $delta < $count; $delta++) {
    if (random_int(0, 1)) {
      $stock = projects_dummy_get_stock_image(random_int(1, 12));
      $file = $file_repository->copy($stock, $stock->getFileUri(), FileExists::Rename);
      $files[] = [
        'target_id' => $file->id(),
        'weight' => $delta,
        'description' => $file_descriptions[random_int(0, count($file_descriptions) - 1)],
      ];
    }
    else {
      $links[] = [
        'value' => 'https://www.example.org/' . $slug . '/' . ($delta + 1),
        'weight' => $delta,
        'description' => $link_descriptions[random_int(0, count($link_descriptions) - 1)],
      ];
    }
  }
  return [$files, $links];
}

/**
 * Completes feedback for some of the people of a completed project.
 *
 * The feedback is created completed, and the event is dispatched here with
 * its time, as the project events above. Feedback::preSave() would log it at
 * the time of the install. The current user is the author of a log, so the
 * events are dispatched as the person who gave the feedback.
 *
 * @param \Drupal\projects\ProjectInterface $project
 *   The completed project.
 * @param \Drupal\creatives\Entity\Creative[] $participants
 *   The creatives of the project.
 * @param int $completed
 *   The time the project was completed.
 * @param int $step_max
 *   The longest time between two feedbacks.
 * @param \Faker\Generator $faker
 *   The generator of random content.
 */
function projects_dummy_complete_feedbacks(ProjectInterface $project, array $participants, int $completed, int $step_max, Generator $faker): void {
  $givers = ['organization' => [$project->getOwner()]];
  foreach ($participants as $participant) {
    $givers['creative'][] = $participant;
  }
  /** @var \Drupal\Core\Session\AccountSwitcherInterface $account_switcher */
  $account_switcher = \Drupal::service('account_switcher');
  /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher */
  $event_dispatcher = \Drupal::service('event_dispatcher');
  $time = $completed;
  foreach ($givers as $bundle => $accounts) {
    foreach ($accounts as $account) {
      if (!$faker->boolean(60)) {
        continue;
      }
      $time += $faker->numberBetween(min(3600, $step_max), $step_max);
      $feedback = Feedback::create([
        'bundle' => $bundle,
        'author' => $account->id(),
        'project' => $project->id(),
        'project_comment' => $faker->sentence(),
        'step' => $bundle === 'organization' ? 5 : 4,
        'created' => $time,
        'completed' => $time,
      ] + projects_dummy_get_feedback_answers($bundle, $faker));
      $feedback->save();
      // Feedback::preSave() adds the public comment to the result only when a
      // save completes the feedback, not when it is created completed.
      $comment = ProjectComment::create([
        'value' => $feedback->get('project_comment')->value,
        'project_result' => $project->getResult()->id(),
        'author' => $account->id(),
        'created' => $time,
      ]);
      $comment->save();
      $project->getResult()->appendComment($comment)->save();
      $account_switcher->switchTo($account);
      try {
        $event_dispatcher->dispatch(new FeedbackCompleteEvent($feedback, $time));
      }
      finally {
        $account_switcher->switchBack();
      }
    }
  }
}

/**
 * Returns random answers for all questions of a feedback bundle.
 *
 * Radios and checkboxes store option indexes. They are taken from the
 * options of the formatter in the default view display, so the admin page
 * shows a label for each of them. The other numbers are scales from 1 to 5.
 *
 * @param string $bundle
 *   The feedback bundle.
 * @param \Faker\Generator $faker
 *   The generator of random content.
 *
 * @return array
 *   The field values, keyed by field name.
 */
function projects_dummy_get_feedback_answers(string $bundle, Generator $faker): array {
  $display = EntityViewDisplay::load('feedback.' . $bundle . '.default');
  $definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('feedback', $bundle);
  $values = [];
  foreach ($definitions as $name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }
    $options = array_column($display?->getComponent($name)['settings']['options'] ?? [], 'value');
    $values[$name] = match (TRUE) {
      $definition->getType() === 'boolean' => $faker->boolean(),
      $definition->getType() === 'string_long' => $faker->optional(0.7)->sentence(),
      $options && $definition->getFieldStorageDefinition()->isMultiple() => $faker->randomElements($options, $faker->numberBetween(1, min(2, count($options)))),
      (bool) $options => $faker->randomElement($options),
      default => $faker->numberBetween(1, 5),
    };
  }
  return $values;
}

/**
 * Runs a step of the dummy content as a user.
 *
 * Logs take their author from the current user.
 *
 * @param int $uid
 *   The id of the user, 0 to run the step without one.
 * @param callable $step
 *   The step.
 */
function projects_dummy_as(int $uid, callable $step): void {
  $account = $uid ? User::load($uid) : NULL;
  if (!$account) {
    $step();
    return;
  }
  /** @var \Drupal\Core\Session\AccountSwitcherInterface $account_switcher */
  $account_switcher = \Drupal::service('account_switcher');
  $account_switcher->switchTo($account);
  try {
    $step();
  }
  finally {
    $account_switcher->switchBack();
  }
}

/**
 * Plans the content edits of a project along its lifecycle.
 *
 * Organizations edit in draft, pending and open, as their edit access allows;
 * managers fix the title in open and adjust mediated projects. Each field is
 * edited at most once.
 *
 * @return array<string, array{by: string, fields: string[]}>
 *   The edits, keyed by the step after which they happen.
 */
function projects_dummy_plan_edits(string $path_state, bool $has_manager, Generator $faker): array {

  $reached = match ($path_state) {
    'draft' => ['draft'],
    'pending' => ['draft', 'pending'],
    'open' => ['draft', 'pending', 'open'],
    default => ['draft', 'pending', 'open', 'mediated'],
  };

  $edits = [];
  if ($faker->boolean()) {
    $edits['draft'] = ['by' => 'organization', 'fields' => [$faker->randomElement(['title', 'body', 'field_city'])]];
  }
  if (in_array('pending', $reached) && $faker->boolean()) {
    $edits['pending'] = ['by' => 'organization', 'fields' => [$faker->randomElement(['body', 'field_deadline'])]];
  }
  if (in_array('open', $reached) && $faker->boolean()) {
    $edits['open'] = $has_manager && $faker->boolean(30)
      ? ['by' => 'manager', 'fields' => ['title']]
      : ['by' => 'organization', 'fields' => [$faker->randomElement(['field_deadline', 'field_workload'])]];
  }
  if (in_array('mediated', $reached) && $has_manager && $faker->boolean(25)) {
    $edits['mediated'] = ['by' => 'manager', 'fields' => ['field_workload']];
  }

  // A field edited twice would show the same final value twice.
  $used = [];
  foreach ($edits as $step => $edit) {
    $edits[$step]['fields'] = array_values(array_diff($edit['fields'], $used));
    $used = array_merge($used, $edits[$step]['fields']);
    if (!$edits[$step]['fields']) {
      unset($edits[$step]);
    }
  }
  return $edits;
}

/**
 * Gets the values a project starts with, before its edits.
 */
function projects_dummy_earlier_values(array $values, array $edits, Generator $faker): array {

  foreach ($edits as $edit) {
    foreach ($edit['fields'] as $field_name) {
      $values[$field_name] = match ($field_name) {
        'title' => ucwords($faker->words(4, TRUE)),
        'body' => [
          'value' => preg_replace('~^[^.]*\.~', rtrim($faker->sentence()), $values['body']['value']),
          'summary' => $values['body']['summary'],
        ],
        'field_city' => $faker->city(),
        // Organizations move the deadline back by one to three weeks.
        'field_deadline' => date('Y-m-d', strtotime($values['field_deadline']) - $faker->numberBetween(7, 21) * 86400),
        'field_workload' => $values['field_workload'] > 1 ? $values['field_workload'] - 1 : 2,
        default => $values[$field_name],
      };
    }
  }
  return $values;
}

/**
 * Runs the edit planned after a step, as its author, one step later.
 */
function projects_dummy_edit(ProjectInterface $project, array $edits, string $step, array $values, int $oid, int $manager, int &$transition_time, int $step_max): void {

  if (!isset($edits[$step])) {
    return;
  }
  $transition_time += random_int(min(86400, $step_max), $step_max);
  foreach ($edits[$step]['fields'] as $field_name) {
    $project->set($field_name, $values[$field_name]);
  }
  // The changed time dates the revision and the log of the edit.
  $project->set('changed', $transition_time);
  $author = $edits[$step]['by'] === 'manager' ? $manager : $oid;
  projects_dummy_as($author, fn () => $project->save());
}
