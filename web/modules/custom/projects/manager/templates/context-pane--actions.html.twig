{#
/**
 * @file
 * The actions of the edit and transition panes: each with its button and a
 * description of what happens, the mediation also with its applicants.
 */
#}
<tr class="context-pane" {{ attributes }}>
  <td colspan="100%">
    {% for action in content.actions|filter((value, key) => key|first != '#') %}
      <div class="context-pane-action">
        {% if action.options is not null %}
          <div class="transition-checkboxes">
            {% for id, option in action.options %}
              <div class="transition-checkbox">
                <input type="checkbox"
                       id="applicant-{{ id }}"
                       name="applicants[]"
                       value="{{ id }}"
                       class="transition-checkbox js-transition-checkbox">
                <label for="applicant-{{ id }}" class="transition-checkbox-option">
                  {{ option }}
                </label>
              </div>
            {% else %}
              {{ 'No applicants found.'|t }}
            {% endfor %}
          </div>
        {% endif %}
        {% if action.users %}
          <div class="transition-checkboxes transition-users">
            {% for user in action.users %}
              <div class="transition-checkbox">
                <div class="transition-checkbox-option">
                  {{ user }}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
        {{ action.button }}
        <div class="transition-description">
          {{ action.description }}
        </div>
      </div>
    {% endfor %}
  </td>
</tr>
