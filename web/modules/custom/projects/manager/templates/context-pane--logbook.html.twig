<tr {{ attributes }} class="context-pane">
  <td colspan="100%">
    {{ content.messages }}
    {% if content.form %}
      {{ content.form }}
    {% elseif content.timeline is defined %}
      <div class="logbook-timeline-flex">
        {{ content.add }}
        {{ content.timeline }}
      </div>
    {% endif %}
  </td>
</tr>
