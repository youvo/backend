<tr {{ attributes }} class="context-pane">
  <td colspan="100%">
    {{ content.messages }}
    {% if content.form %}
      {{ content.form }}
    {% elseif content.rows is defined %}
      <div class="logbook-timeline-flex">
        {% for row in content.rows %}
          <div class="logbook-timeline-flex-row" data-timeline-type="{{ row.type }}">
            {{ row.build }}
            {% if row.actions %}
              <div class="logbook-timeline-actions">
                {{ row.actions.edit }}
                {{ row.actions.delete }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </td>
</tr>
