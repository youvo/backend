<tr {{ attributes }} class="context-pane">
  <td colspan="100%">
    <div class="manager-mail-pane">
      {{ content.messages }}
      {{ content.form }}
      {% for link in content.mails %}
        <div class="manager-mail-pane-item">{{ link }}</div>
      {% endfor %}
      {{ content.empty }}
      {{ content.notes }}
      {{ content.last }}
    </div>
  </td>
</tr>
