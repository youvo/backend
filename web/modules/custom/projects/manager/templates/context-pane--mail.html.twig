<tr {{ attributes }} class="context-pane">
  <td colspan="100%">
    <div class="manager-mail-pane">
      {{ content.messages }}
      <div class="manager-mail-main">
        {{ content.form }}
        {{ content.empty }}
      </div>
      {% if content.mails or content.last %}
        <aside class="manager-mail-side">
          {% if content.mails %}
            <h4 class="manager-mail-side-title">{{ 'Mail type'|t }}</h4>
            <div class="manager-mail-types">
              {% for link in content.mails %}
                {{ link }}
              {% endfor %}
            </div>
          {% endif %}
          {{ content.last }}
        </aside>
      {% endif %}
    </div>
  </td>
</tr>
