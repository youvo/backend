{#
/**
 * @file
 * The block with the projects of a manager.
 *
 * Available variables:
 * - cards: The projects, each with id, title, url, organization, is_new, count,
 *   seen_url, progress (steps) and logs (label, text).
 * - more_url: The link to the overview if there are more projects.
 * - seen_all_url: The URL that confirms all projects, if one is new.
 */
#}
<div class="manager-projects">
  {% if cards %}
    {% if seen_all_url %}
      <form class="manager-projects__all" method="post" action="{{ seen_all_url }}">
        <button type="submit" class="button">{{ 'Mark all as seen'|t }}</button>
      </form>
    {% endif %}
    {% for card in cards %}
      <article class="manager-projects__card{{ card.is_new ? ' is-new' : '' }}">
        <header class="manager-projects__head">
          <div>
            <h3 class="manager-projects__title"><a href="{{ card.url }}">{{ card.title }}</a></h3>
            <div class="manager-projects__org">{{ card.organization }}</div>
          </div>
          {% if card.is_new %}
            <span class="manager-projects__badge">{% if card.count %}{{ '@count new'|t({'@count': card.count}) }}{% else %}{{ 'New'|t }}{% endif %}</span>
          {% endif %}
        </header>
        <div class="manager-projects__progress">
          {% for step in card.progress %}
            <div class="manager-projects__step{{ step.completed ? ' is-completed' : '' }}{{ not loop.last ? ' has-segment' : '' }}{{ step.next_completed ? ' is-next-completed' : '' }}">
              <span class="manager-projects__dot"></span>
              <span class="manager-projects__step-label">{{ step.label }}</span>
            </div>
          {% endfor %}
        </div>
        {% if card.logs %}
          <ul class="manager-projects__logs">
            {% for log in card.logs %}
              <li class="manager-projects__log">
                <span class="manager-projects__log-label">{{ log.label }}</span>
                <span class="manager-projects__log-text">{{ log.text }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if card.seen_url %}
          <form class="manager-projects__confirm" method="post" action="{{ card.seen_url }}">
            <button type="submit" class="button">{{ 'Mark as seen'|t }}</button>
          </form>
        {% endif %}
      </article>
    {% endfor %}
    {% if more_url %}
      <p class="manager-projects__more"><a href="{{ more_url }}">{{ 'All projects'|t }}</a></p>
    {% endif %}
  {% else %}
    <p class="manager-projects__empty">{{ 'No running projects'|t }}</p>
  {% endif %}
</div>
