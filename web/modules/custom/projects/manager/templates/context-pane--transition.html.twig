<tr class="context-pane" {{ attributes }}>
  <td colspan="100%">
    {% if content.options is not null %}
      <div class="transition-checkboxes">
        {% if content.options %}
          {% for id, option in content.options %}
            <div class="transition-checkbox">
              <input type="checkbox"
                     id="applicant-{{ id }}"
                     name="applicants[]"
                     value="{{ id }}"
                     class="transition-checkbox js-transition-checkbox">
              <label for="applicant-{{ id }}" class="transition-checkbox-option">
                {{ option }}
              </label>
            </div>
          {% endfor %}
        {% else %}
          {{ 'No applicants found.'|t }}
        {% endif %}
      </div>
    {% endif %}
    {% if content.users %}
      <div class="transition-checkboxes transition-users">
        {% for user in content.users %}
          <div class="transition-checkbox">
            <div class="transition-checkbox-option">
              {{ user }}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {{ content.button }}
    {{ content.decline }}
    {% if content.description %}
      <div class="transition-description">
        {{ content.description }}
      </div>
    {% endif %}
  </td>
</tr>
