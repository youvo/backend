{
  "name": "manager",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint:css": "stylelint 'css/**/*.css'",
    "lint:css:fix": "stylelint 'css/**/*.css' --fix",
    "format:css": "prettier --write 'css/**/*.css'",
    "lint:js": "prettier --check 'js/**/*.js'",
    "format:js": "prettier --write 'js/**/*.js'",
    "lint": "yarn lint:css && yarn lint:js",
    "format": "yarn format:css && yarn format:js"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "postcss-url": "^10.1.4",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
