{#
/**
 * @file
 * The page behind a link in a mail.
 *
 * Available variables:
 * - heading: The heading of the door target.
 * - context: The project title.
 * - note: A note above the button, or empty.
 * - form: The form with the button.
 */
#}
<div class="mail-door">
  <p class="mail-door-context">{{ context }}</p>
  <h1 class="mail-door-heading">{{ heading }}</h1>
  {% if note %}
    <p class="mail-door-note">{{ note }}</p>
  {% endif %}
  {{ form }}
</div>
