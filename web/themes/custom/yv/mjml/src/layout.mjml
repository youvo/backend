<mjml lang="de">
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#2a2a2a" padding="0" />
    </mj-attributes>
    <mj-style>
      .yv-body { word-break: break-word; }
      .yv-body a { color: #15508e; text-decoration: underline; }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light">
      <meta name="supported-color-schemes" content="light">
      <!--[if mso]><style type="text/css">
        body, table, td, div, p, a { font-family: 'Segoe UI', Arial, sans-serif !important; }
        .yv-body p { margin: 16px 0 !important; }
        .yv-body div, .yv-body p { mso-line-height-rule: exactly; }
      </style><![endif]-->
    </mj-raw>
  </mj-head>
  <mj-body background-color="#f4f8ff">
    <mj-section full-width="full-width" background-color="#3ec4c2" padding="28px 20px 0 20px">
      <mj-column>
        <mj-text padding="0 32px 20px 32px" line-height="0"><a href="{{ url('<front>') }}" target="_blank" style="color:#2a2a2a;"><img src="{{ url('<front>') }}assets/logo_email.png" alt="youvo – You create. You volunteer." width="245" height="76" style="display:block;border:0;width:100%;max-width:245px;height:auto;color:#2a2a2a;" /></a></mj-text>
        <mj-spacer height="24px" container-background-color="#ffffff" />
      </mj-column>
    </mj-section>
    <mj-section full-width="full-width" padding="0 20px">
      <mj-column>
        <mj-text css-class="yv-body" padding="0 32px 24px 32px" container-background-color="#ffffff">{{ body }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 12px 32px 12px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="20px" color="#2a2a2a">youvo e.V. · <a href="{{ url('<front>') }}" style="color:#15508e;text-decoration:underline;">youvo.org</a><br />Du erhältst diese E-Mail, weil Du auf youvo.org registriert bist oder an einem Projekt beteiligt bist.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
