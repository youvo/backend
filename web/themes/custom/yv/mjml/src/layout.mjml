<mjml lang="de">
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="24px" color="#1a1a1a" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section padding="24px 0 8px 0">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold"><a href="https://youvo.org" style="color:#1a1a1a;text-decoration:none;">youvo</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text>{{ body }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 0 24px 0">
      <mj-column>
        <mj-text font-size="12px" color="#777777">youvo e.V. · <a href="https://youvo.org" style="color:#777777;">youvo.org</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
