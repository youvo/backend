{#
/**
 * @file
 * Full view of a creative in the backend.
 *
 * The plain values in "profile" come from yv_preprocess_user() and are set
 * only when the viewer may see the field.
 */
#}
{% set facts = [profile.city, profile.education]|filter(fact => fact) %}

{{ profile_cache }}
<article{{ attributes.addClass('user-profile') }}>
  <div class="user-profile-main">
    <header class="user-profile-header">
      {% include '@yv/user/includes/user-profile-avatar.html.twig' with {avatar: content.field_avatar|field_value, initials: profile.initials, shape: 'round'} only %}
      <div class="user-profile-heading">
        <h1 class="user-profile-name">{{ profile.name }}</h1>
        {% if profile.position %}
          <p class="user-profile-subtitle">{{ profile.position }}</p>
        {% endif %}
        {% if facts %}
          <p class="user-profile-subtitle">{{ facts|join(' · ') }}</p>
        {% endif %}
        {% if profile.projects %}
          <p class="user-profile-subtitle">
            {{ 'Projects'|t }}:
            {% for count in profile.projects %}
              <span class="user-profile-count">{{ count }}</span>{{ not loop.last ? ' · ' }}
            {% endfor %}
          </p>
        {% endif %}
      </div>
    </header>

    {% if content.field_about|field_value %}
      <div class="user-profile-about">{{ content.field_about|field_value }}</div>
    {% endif %}

    {% set skills = content.field_skills|field_value %}
    {% if skills %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Skills'|t }}</h2>
        <div class="user-profile-skills">{{ skills }}</div>
      </section>
    {% endif %}

    {% if profile.links %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Portfolio'|t }}</h2>
        <ul class="user-profile-tags">
          {% include '@yv/user/includes/user-profile-links.html.twig' with {links: profile.links} only %}
        </ul>
      </section>
    {% endif %}

    {% if profile.organizations %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Managed organizations'|t }}</h2>
        {% set limit = 6 %}
        <ul class="user-profile-organizations">
          {% for organization in profile.organizations|slice(0, limit) %}
            <li>{{ organization }}</li>
          {% endfor %}
        </ul>
        {% if profile.organizations|length > limit %}
          {# Opens once and stays open: all organizations are already on the page. #}
          <details class="user-profile-more">
            <summary class="button button--small">{{ 'and @count more'|t({'@count': profile.organizations|length - limit}) }}</summary>
            <ul class="user-profile-organizations">
              {% for organization in profile.organizations|slice(limit) %}
                <li>{{ organization }}</li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </section>
    {% endif %}
  </div>

  <aside class="user-profile-side">
    {% include '@yv/user/includes/user-profile-contact.html.twig' with {profile: profile} only %}

    {% include '@yv/user/includes/user-profile-account.html.twig' with {account: profile.account} only %}

    {% if profile.preferences %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Preferences'|t }}</h2>
        <dl class="user-profile-facts">
          {% for preference in profile.preferences %}
            <div><dt>{{ preference.label }}</dt><dd>{{ preference.value }}</dd></div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}

    {% if profile.feedback %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Feedback'|t }}</h2>
        <dl class="user-profile-facts">
          {% for item in profile.feedback %}
            <div>
              <dt>
                {% if item.url %}
                  <a href="{{ item.url }}">{{ item.project }}</a>
                {% else %}
                  {{ item.project }}
                {% endif %}
              </dt>
              <dd>{{ item.date }}</dd>
            </div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}

    {% if profile.courses %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Academy'|t }}</h2>
        <dl class="user-profile-facts">
          {% for course in profile.courses %}
            <div><dt>{{ course.title }}</dt><dd>{{ course.status }}</dd></div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}
  </aside>

  {% include '@yv/user/includes/user-profile-views.html.twig' with {user_id: user.id, projects_view: 'creative_projects'} only %}
</article>
