{#
/**
 * @file
 * Full view of a creative in the backend.
 *
 * The plain fields come from the full display in "content". The values in
 * "profile" come from yv_preprocess_user(), for what the display cannot show,
 * and are set only when the viewer may see the fields.
 */
#}

{{ profile_cache }}
<article{{ attributes.addClass('user-profile') }}>
  <div class="user-profile-main">
    {% include '@yv/user/includes/user-profile-header.html.twig' with {content: content, profile: profile} only %}

    {% include '@yv/user/includes/user-profile-main.html.twig' with {content: content} only %}

    {{ drupal_view('managed_organizations', 'profile', user.id) }}
  </div>

  <aside class="user-profile-side">
    {% include '@yv/user/includes/user-profile-contact.html.twig' with {mail: profile.mail, phone: content.field_phone|field_value} only %}

    {% include '@yv/user/includes/user-profile-account.html.twig' with {account: profile.account} only %}

    {% set preferences = [
      {label: 'Job offers'|t, value: content.field_jobs|field_value},
      {label: 'Newsletter'|t, value: content.field_newsletter|field_value},
      {label: 'Public profile'|t, value: content.field_public_profile|field_value},
    ]|filter(preference => preference.value) %}
    {% if preferences %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Preferences'|t }}</h2>
        <dl class="user-profile-facts">
          {% for preference in preferences %}
            <div><dt>{{ preference.label }}</dt><dd>{{ preference.value }}</dd></div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}

    {{ drupal_view('feedback', 'profile', user.id) }}

    {% if profile.courses %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Academy'|t }}</h2>
        <dl class="user-profile-facts">
          {% for course in profile.courses %}
            <div><dt>{{ course.title }}</dt><dd>{{ course.status }}</dd></div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}
  </aside>

  {% include '@yv/user/includes/user-profile-views.html.twig' with {user_id: user.id, projects_view: 'creative_projects'} only %}
</article>
