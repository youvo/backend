{#
/**
 * @file
 * The feedback a user gave per project; the date links to each feedback the
 * viewer may open.
 */
#}
{% if feedback %}
  <section class="user-profile-section">
    <h2 class="user-profile-section-title">{{ 'Feedback'|t }}</h2>
    <dl class="user-profile-facts">
      {% for item in feedback %}
        <div>
          <dt>{{ item.project }}</dt>
          <dd>
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.date }}<span class="visually-hidden">: {{ 'feedback on @project'|t({'@project': item.project}) }}</span></a>
            {% else %}
              {{ item.date }}
            {% endif %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  </section>
{% endif %}
