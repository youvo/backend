{#
/**
 * @file
 * The logbook and the projects of a profile, below both columns.
 *
 * Both are empty for viewers without access to their view.
 */
#}
{% set sections = [
  {title: 'Logbook'|t, content: drupal_view('logbook', 'profile', user_id)},
  {title: 'Projects'|t, content: drupal_view(projects_view, 'block', user_id)},
] %}
{% for section in sections|filter(section => section.content) %}
  <section class="user-profile-wide" aria-label="{{ section.title }}">
    {{ section.content }}
  </section>
{% endfor %}
