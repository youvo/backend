{#
/**
 * @file
 * The contact options of a profile.
 *
 * Variables: mail (plain address), phone (the rendered field) and address
 * (rendered, organizations only).
 */
#}
{% if mail or phone or address %}
  <section class="user-profile-section">
    <h2 class="user-profile-section-title">{{ 'Contact'|t }}</h2>
    <ul class="user-profile-contact">
      {% if mail %}
        <li><a href="mailto:{{ mail }}">{{ mail }}</a></li>
      {% endif %}
      {% if phone %}
        <li>{{ phone }}</li>
      {% endif %}
      {% if address %}
        <li><address>{{ address }}</address></li>
      {% endif %}
    </ul>
  </section>
{% endif %}
