{#
/**
 * @file
 * Full view of an organization in the backend.
 *
 * The plain fields come from the full display in "content". The values in
 * "profile" come from yv_preprocess_user(), for what the display cannot show,
 * and are set only when the viewer may see the fields.
 */
#}
{% set registration = [
  {label: 'Reachability'|t, value: content.field_reachability|field_value},
  {label: 'Referral'|t, value: content.field_referral|field_value},
  {label: 'Publicity'|t, value: content.field_publicity|field_value},
] %}

{{ profile_cache }}
<article{{ attributes.addClass('user-profile') }}>
  <div class="user-profile-main">
    <header class="user-profile-header">
      {% include '@yv/user/includes/user-profile-avatar.html.twig' with {avatar: profile.avatar, initials: profile.initials} only %}
      <div class="user-profile-heading">
        <h1 class="user-profile-name">{{ content.field_name|field_value }}</h1>
        {% if profile.short_name %}
          <p class="user-profile-subtitle">{{ profile.short_name }}</p>
        {% endif %}
        {% if profile.projects %}
          <p class="user-profile-subtitle">
            {{ 'Projects'|t }}:
            {% for count in profile.projects %}
              <span class="user-profile-count">{{ count }}</span>{{ not loop.last ? ' · ' }}
            {% endfor %}
          </p>
        {% endif %}
        {% set causes = content.field_causes|field_value %}
        {% if causes %}
          <ul class="user-profile-tags">
            {% for cause in causes %}
              <li><span class="user-profile-chip">#{{ cause }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </header>

    {% if content.field_aim|field_value %}
      <p class="user-profile-aim">{{ content.field_aim|field_value }}</p>
    {% endif %}

    {% if content.field_about|field_value %}
      <div class="user-profile-about">{{ content.field_about|field_value }}</div>
    {% endif %}

    {% if content.field_budget|field_value %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Why there is no budget for creative work'|t }}</h2>
        <p class="user-profile-budget">{{ content.field_budget|field_value }}</p>
      </section>
    {% endif %}

{% set links = (content.field_url|field_value ?: [])|merge(content.field_portfolio|field_value ?: []) %}
    {% if links %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Links'|t }}</h2>
        <ul class="user-profile-tags user-profile-links">
          {% include '@yv/user/includes/user-profile-links.html.twig' with {links: links} only %}
        </ul>
      </section>
    {% endif %}

    {# The contact is a name, not an account, so it gets the markup of a
       person by hand. #}
    {% set contact = content.field_contact|field_value %}
    {% set manager = content.field_manager|field_value %}
    {% if contact or manager %}
      <section>
        <h2 class="user-profile-section-title">{{ 'Contacts'|t }}</h2>
        <ul class="person-list">
          {% if contact %}
            <li>
              <span class="person">
                <span class="person-avatar" aria-hidden="true">{{ profile.contact_initials }}</span>
                <span class="person-name">{{ contact }}</span>
              </span>
              <span class="person-role">{{ 'Contact'|t }}</span>
            </li>
          {% endif %}
          {% if manager %}
            <li>
              {{ manager }}
              <span class="person-role">{{ 'Manager'|t }}</span>
            </li>
          {% endif %}
        </ul>
      </section>
    {% endif %}
  </div>

  <aside class="user-profile-side">
    {# The address and the staff from their fields, printed one by one, as
       joining rendered fields would escape them twice. #}
    {% set street = content.field_street|field_value %}
    {% set zip = content.field_zip|field_value %}
    {% set city = content.field_city|field_value %}
    {% set country = content.field_country|field_value %}
    {% set address %}
      {%- if street or zip or city or country -%}
        {{ street }}{{ street and (zip or city or country) ? ', ' }}{{ zip }}{{ zip and city ? ' ' }}{{ city }}{{ (zip or city) and country ? ', ' }}{{ country }}
      {%- endif -%}
    {% endset %}
    {% include '@yv/user/includes/user-profile-contact.html.twig' with {mail: profile.mail, phone: content.field_phone|field_value, address: address|trim} only %}

    {% set fulltime = content.field_count_fulltime|field_value %}
    {% set volunteer = content.field_count_volunteer|field_value %}
    {% set staff = [] %}
    {% if fulltime or volunteer %}
      {% set staff_value %}{{ fulltime ?: '–' }} {{ 'full-time'|t }} · {{ volunteer ?: '–' }} {{ 'volunteers'|t }}{% endset %}
      {% set staff = [{label: 'Staff'|t, value: staff_value}] %}
    {% endif %}
    {% include '@yv/user/includes/user-profile-account.html.twig' with {account: profile.account, extra: staff} only %}

    {% set answers = registration|filter(item => item.value|render|striptags|trim) %}
    {% if answers %}
      <section class="user-profile-section">
        <h2 class="user-profile-section-title">{{ 'Registration'|t }}</h2>
        <dl class="user-profile-answers">
          {% for item in answers %}
            <div>
              <dt>{{ item.label }}</dt>
              <dd>{{ item.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </section>
    {% endif %}

    {{ drupal_view('feedback', 'profile', user.id) }}
  </aside>

  {% include '@yv/user/includes/user-profile-views.html.twig' with {user_id: user.id, projects_view: 'organization_projects'} only %}
</article>
