{#
/**
 * @file
 * Teaser of a project, like the project cards of the frontend.
 *
 * On a creative's profile, "creative_role" is their role in the project:
 * "managed", "participant" or "applied".
 */
#}
{% set project = elements['#project'] %}
{{ project_cache }}
<article class="project-teaser">
  <div class="project-teaser-image">
    {{ elements.field_image|field_value }}
  </div>
  <div class="project-teaser-body">
    <div class="project-teaser-heading">
      <h3 class="project-teaser-title">
        {% if url %}
          <a href="{{ url }}">{{ elements.title|field_value }}</a>
        {% else %}
          {{ elements.title|field_value }}
        {% endif %}
      </h3>
      {% if organization %}
        <p class="project-teaser-organization">{{ organization }}</p>
      {% endif %}
    </div>
    <div class="project-teaser-meta">
      <span class="project-teaser-badge" data-badge="{{ project.field_lifecycle.value|clean_class }}">{{ elements.field_lifecycle|field_value }}</span>
      {% set role_labels = {managed: 'Manager'|t, participant: 'Participant'|t, applied: 'Applied'|t} %}
      {% if creative_role %}
        <span class="project-teaser-badge" data-badge="{{ creative_role }}">{{ role_labels[creative_role] }}</span>
      {% endif %}
      {% if not project.isPublished() %}
        <span class="project-teaser-badge" data-badge="archived">{{ 'Archived'|t }}</span>
      {% endif %}
      {% if project.isHidden() %}
        <span class="project-teaser-badge" data-badge="hidden">{{ 'Hidden'|t }}</span>
      {% endif %}
      <span class="project-teaser-skills">{{ elements.field_skills|field_value }}</span>
    </div>
  </div>
</article>
