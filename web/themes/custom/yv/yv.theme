<?php

/**
 * @file
 * Provides preprocess logic and other functionality for theming.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\creatives\Entity\Creative;
use Drupal\organizations\Entity\Organization;
use Drupal\projects\ProjectInterface;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_taxonomy_term_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $variables['elements']['#taxonomy_term'];
  $vocabulary = $term->bundle();
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'taxonomy_term__' . $vocabulary . '__' . $view_mode;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\user\UserInterface $user */
  $user = $variables['elements']['#user'];
  $user_type = $user->bundle();
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'user__' . $user_type . '__' . $view_mode;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_menu_alter(array &$suggestions, array $variables): void {
  if (str_starts_with($variables['menu_name'] ?? '', 'dashboard-')) {
    $suggestions[] = 'menu__dashboard';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 *
 * The profiles of organizations and creatives show the name themselves.
 */
function yv_preprocess_page_title(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'entity.user.canonical' &&
    ($route_match->getParameter('user') instanceof Organization ||
    $route_match->getParameter('user') instanceof Creative)) {
    $variables['title'] = '';
  }
}

/**
 * Implements hook_preprocess_HOOK() for user.
 *
 * Prepares the plain values of the profile of an organization or a creative.
 * Each value is only set when the viewer may see the field, and the access
 * results bubble up through the profile_cache render array.
 */
function yv_preprocess_user(array &$variables): void {

  $user = $variables['elements']['#user'];
  if ($variables['elements']['#view_mode'] !== 'full' ||
    !($user instanceof Organization || $user instanceof Creative)) {
    return;
  }

  $cache = new CacheableMetadata();
  // The field access of creatives allows their private fields to themselves
  // without varying per user, so their profile does.
  if ($user instanceof Creative) {
    $cache->addCacheContexts(['user']);
  }
  $value = static function (string $field_name) use ($user, $cache): ?string {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    $value = $access->isAllowed() ? trim((string) $user->get($field_name)->value) : '';
    return $value !== '' ? $value : NULL;
  };
  $initials = static fn (?string $name): string => implode('', array_map(
    static fn (string $word): string => mb_strtoupper(mb_substr($word, 0, 1)),
    array_slice(preg_grep('/^\p{L}/u', preg_split('/\s+/', (string) $name)), 0, 2),
  ));

  // Links: the website and all portfolio entries. Only http(s) values become
  // links, anything else is shown as text.
  $links = [];
  foreach (['field_url', 'field_portfolio'] as $field_name) {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    foreach ($user->get($field_name) as $item) {
      // A value without an address, such as "https://www.", is left out.
      $link = trim((string) $item->get('value')->getValue());
      $label = rtrim(preg_replace('{^(https?://)?(www\.)?}i', '', $link), '/');
      if ($label === '') {
        continue;
      }
      $links[] = [
        'url' => preg_match('{^https?://}i', $link) ? $link : NULL,
        'label' => $label,
      ];
    }
  }

  $name = $value('field_name');
  $phone = $value('field_phone');
  $profile = [
    'name' => $name,
    'initials' => $initials($name),
    'links' => $links,
    'mail' => $value('mail'),
    'phone' => $phone,
    'phone_uri' => $phone ? 'tel:' . preg_replace('/[^\d+]/', '', $phone) : NULL,
  ];

  if ($user instanceof Organization) {
    $contact = $value('field_contact');
    $profile += [
      'short_name' => $value('field_short_name'),
      'contact' => $contact,
      'contact_initials' => $initials($contact),
      'address' => array_filter([
        $value('field_street'),
        trim($value('field_zip') . ' ' . $value('field_city')),
        $value('field_country'),
      ]),
      'fulltime' => $value('field_count_fulltime'),
      'volunteer' => $value('field_count_volunteer'),
    ];

    // The manager pill links to the profile of the manager.
    $profile['manager_url'] = NULL;
    $manager_access = $user->get('field_manager')->access('view', NULL, TRUE);
    $cache->addCacheableDependency($manager_access);
    $manager = $manager_access->isAllowed() ? $user->getManager() : NULL;
    if ($manager) {
      $access = $manager->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($manager);
      if ($access->isAllowed()) {
        $profile['manager_url'] = $manager->toUrl()->toString();
      }
    }
  }

  if ($user instanceof Creative) {
    $profile += [
      'position' => $value('field_position'),
      'education' => $value('field_education'),
      'city' => $value('field_city'),
    ];

    // Yes or no answers that only staff and the creative may see.
    $preferences = [];
    foreach ([
      'field_jobs' => t('Job offers'),
      'field_newsletter' => t('Newsletter'),
      'field_public_profile' => t('Public profile'),
    ] as $field_name => $label) {
      $flag = $value($field_name);
      if ($flag !== NULL) {
        $preferences[] = ['label' => $label, 'value' => $flag ? t('Yes') : t('No')];
      }
    }
    $profile['preferences'] = $preferences;
  }

  // Account data that only staff may see.
  $date_formatter = \Drupal::service('date.formatter');
  $account = [];
  foreach (['status', 'roles', 'created', 'login'] as $field_name) {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $account[$field_name] = TRUE;
    }
  }
  if (isset($account['status'])) {
    $account['status'] = $user->isActive() ? t('Active') : t('Blocked');
  }
  if (isset($account['roles'])) {
    $roles = \Drupal::entityTypeManager()->getStorage('user_role')
      ->loadMultiple($user->getRoles(TRUE));
    $account['roles'] = implode(', ', array_map(static fn ($role) => $role->label(), $roles));
    foreach ($roles as $role) {
      $cache->addCacheableDependency($role);
    }
  }
  if (isset($account['created'])) {
    $account['created'] = $date_formatter->format($user->getCreatedTime(), 'custom', 'd.m.Y');
  }
  if (isset($account['login'])) {
    $login = $user->getLastLoginTime();
    $account['login'] = $login ? $date_formatter->format((int) $login, 'custom', 'd.m.Y') : t('Never');
  }
  $profile['account'] = array_filter($account);

  $variables['profile'] = $profile;
  $variables['profile_cache'] = [];
  $cache->applyTo($variables['profile_cache']);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_unformatted.
 *
 * On a creative's profile, the teasers of projects the creative manages say
 * so. The flag is part of the cache keys, because the same teasers show
 * elsewhere without it.
 */
function yv_preprocess_views_view_unformatted(array &$variables): void {

  $view = $variables['view'];
  if ($view->id() !== 'creative_projects') {
    return;
  }

  $creative = (int) ($view->args[0] ?? 0);
  foreach ($variables['rows'] as $key => &$row) {
    $project = $view->result[$key]->_entity ?? NULL;
    if (!$project instanceof ProjectInterface) {
      continue;
    }
    $owner = $project->getOwner();
    if ($owner instanceof Organization && $owner->getManager()?->id() == $creative) {
      $row['content']['#managed'] = TRUE;
      $row['content']['#cache']['keys'][] = 'managed';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for project.
 *
 * The teaser links its title only when the viewer may see the project, and
 * names the organization of the project by its short name, as the frontend
 * does.
 */
function yv_preprocess_project(array &$variables): void {

  $project = $variables['elements']['#project'];
  if (!$project instanceof ProjectInterface || $variables['elements']['#view_mode'] !== 'teaser') {
    return;
  }

  $cache = new CacheableMetadata();
  $access = $project->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  $variables['url'] = $access->isAllowed() ? $project->toUrl()->toString() : NULL;

  $variables['managed'] = !empty($variables['elements']['#managed']);
  $variables['organization'] = NULL;
  $owner = $project->getOwner();
  if ($owner instanceof Organization) {
    $cache->addCacheableDependency($owner);
    foreach (['field_short_name', 'field_name'] as $field_name) {
      $field_access = $owner->get($field_name)->access('view', NULL, TRUE);
      $cache->addCacheableDependency($field_access);
      $name = trim((string) $owner->get($field_name)->value);
      if ($field_access->isAllowed() && $name !== '') {
        $variables['organization'] = $name;
        break;
      }
    }
  }

  $variables['project_cache'] = [];
  $cache->applyTo($variables['project_cache']);
}
