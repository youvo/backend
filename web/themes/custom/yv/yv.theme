<?php

/**
 * @file
 * Provides preprocess logic and other functionality for theming.
 */

use Drupal\Component\Utility\UrlHelper;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\courses\Entity\Course;
use Drupal\creatives\Entity\Creative;
use Drupal\file\FileInterface;
use Drupal\image\ImageStyleInterface;
use Drupal\lifecycle\Plugin\Field\FieldType\LifecycleItem;
use Drupal\organizations\Entity\Organization;
use Drupal\projects\ProjectInterface;
use Drupal\projects\ProjectResultInterface;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_taxonomy_term_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $variables['elements']['#taxonomy_term'];
  $vocabulary = $term->bundle();
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'taxonomy_term__' . $vocabulary . '__' . $view_mode;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\user\UserInterface $user */
  $user = $variables['elements']['#user'];
  $user_type = $user->bundle();
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'user__' . $user_type . '__' . $view_mode;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function yv_theme_suggestions_menu_alter(array &$suggestions, array $variables): void {
  if (str_starts_with($variables['menu_name'] ?? '', 'dashboard-')) {
    $suggestions[] = 'menu__dashboard';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 *
 * The profiles of organizations and creatives, the feedback page and the
 * project page show their title themselves.
 */
function yv_preprocess_page_title(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'entity.user.canonical' &&
    ($route_match->getParameter('user') instanceof Organization ||
    $route_match->getParameter('user') instanceof Creative)) {
    $variables['title'] = '';
  }
  if (in_array($route_match->getRouteName(), ['entity.feedback.canonical', 'entity.project.canonical'], TRUE)) {
    $variables['title'] = '';
  }
}

/**
 * Implements hook_preprocess_HOOK() for user.
 *
 * The templates print plain values, so field access is checked here and its
 * cacheability bubbles up through profile_cache.
 */
function yv_preprocess_user(array &$variables): void {

  $user = $variables['elements']['#user'];

  if ($user instanceof Organization && $variables['elements']['#view_mode'] === 'teaser') {
    $access = $user->access('view', NULL, TRUE);
    $variables['url'] = $access->isAllowed() && !$user->isNew() ? $user->toUrl()->toString() : NULL;
    $variables['initials'] = yv_initials($user->getName());
    $teaser_cache = CacheableMetadata::createFromObject($access);
    $variables['avatar'] = yv_avatar($user, $teaser_cache);
    $variables['teaser_cache'] = [];
    $teaser_cache->applyTo($variables['teaser_cache']);
    return;
  }

  if ($variables['elements']['#view_mode'] !== 'full' ||
    !($user instanceof Organization || $user instanceof Creative)) {
    return;
  }

  // The plain fields come from the full display in "content"; the values
  // here are what the display cannot show.
  $cache = new CacheableMetadata();
  yv_content_cache($variables['content'], $cache);
  $value = static function (string $field_name) use ($user, $cache): ?string {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    $value = $access->isAllowed() ? trim((string) $user->get($field_name)->value) : '';
    return $value !== '' ? $value : NULL;
  };

  // Only http(s) values become links, so other schemes are shown as text.
  $links = [];
  foreach (['field_url', 'field_portfolio'] as $field_name) {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    foreach ($user->get($field_name) as $item) {
      // A value without an address, such as "https://www.", is left out.
      $link = trim((string) $item->get('value')->getValue());
      $label = rtrim(preg_replace('{^(https?://)?(www\.)?}i', '', $link), '/');
      if ($label === '') {
        continue;
      }
      $links[] = [
        'url' => preg_match('{^https?://}i', $link) ? $link : NULL,
        'label' => $label,
      ];
    }
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $date_formatter = \Drupal::service('date.formatter');
  $staff = AccessResult::allowedIfHasPermission(\Drupal::currentUser(), 'general manager access');
  $cache->addCacheableDependency($staff);

  $name = $value('field_name');
  $phone = $value('field_phone');
  $profile = [
    'initials' => yv_initials($name),
    'avatar' => yv_avatar($user, $cache),
    'links' => $links,
    'mail' => $value('mail'),
    'phone' => $phone,
    'phone_uri' => $phone ? 'tel:' . preg_replace('/[^\d+]/', '', $phone) : NULL,
  ];

  if ($user instanceof Organization) {
    $short_name = $value('field_short_name');
    $profile += [
      // Only a short name that differs from the name says something.
      'short_name' => $short_name !== $name ? $short_name : NULL,
      'contact_initials' => yv_initials($value('field_contact')),
      'address' => array_filter([
        $value('field_street'),
        trim($value('field_zip') . ' ' . $value('field_city')),
        $value('field_country'),
      ]),
      'fulltime' => $value('field_count_fulltime'),
      'volunteer' => $value('field_count_volunteer'),
    ];

    $profile['manager_name'] = NULL;
    $profile['manager_url'] = NULL;
    $profile['manager_avatar'] = NULL;
    $profile['manager_initials'] = NULL;
    $manager_access = $user->get('field_manager')->access('view', NULL, TRUE);
    $cache->addCacheableDependency($manager_access);
    $manager = $manager_access->isAllowed() ? $user->getManager() : NULL;
    if ($manager) {
      $profile['manager_name'] = $manager->getName();
      $profile['manager_avatar'] = yv_avatar($manager, $cache);
      $profile['manager_initials'] = yv_initials($manager->getName());
      $access = $manager->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($manager);
      if ($access->isAllowed()) {
        $profile['manager_url'] = $manager->toUrl()->toString();
      }
    }

    // Counts only the projects the viewer may see, as the projects list does.
    $project_storage = $entity_type_manager->getStorage('project');
    $cache->addCacheTags(['project_list']);
    $project_ids = $project_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('uid', $user->id())
      ->execute();
    $counts = ['completed' => 0, 'ongoing' => 0, 'open' => 0, 'pending' => 0, 'draft' => 0, 'declined' => 0];
    /** @var \Drupal\projects\ProjectInterface $project */
    foreach ($project_storage->loadMultiple($project_ids) as $project) {
      $access = $project->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($project);
      if (!$access->isAllowed()) {
        continue;
      }
      $lifecycle = $project->lifecycle();
      match (TRUE) {
        $lifecycle->isCompleted() => $counts['completed']++,
        $lifecycle->isOngoing() => $counts['ongoing']++,
        $lifecycle->isOpen() => $counts['open']++,
        $lifecycle->isPending() => $counts['pending']++,
        $lifecycle->isDraft() => $counts['draft']++,
        $lifecycle->isDeclined() => $counts['declined']++,
        default => NULL,
      };
    }
    $profile['projects'] = array_filter([
      $counts['completed'] ? \Drupal::translation()->formatPlural($counts['completed'], '1 completed', '@count completed') : NULL,
      $counts['ongoing'] ? \Drupal::translation()->formatPlural($counts['ongoing'], '1 ongoing', '@count ongoing') : NULL,
      $counts['open'] ? \Drupal::translation()->formatPlural($counts['open'], '1 open', '@count open') : NULL,
      $counts['pending'] ? \Drupal::translation()->formatPlural($counts['pending'], '1 pending', '@count pending') : NULL,
      $counts['draft'] ? \Drupal::translation()->formatPlural($counts['draft'], '1 draft', '@count drafts') : NULL,
      $counts['declined'] ? \Drupal::translation()->formatPlural($counts['declined'], '1 declined', '@count declined') : NULL,
    ]);
  }

  if ($user instanceof Creative) {
    $preferences = [];
    foreach ([
      'field_jobs' => t('Job offers'),
      'field_newsletter' => t('Newsletter'),
      'field_public_profile' => t('Public profile'),
    ] as $field_name => $label) {
      $flag = $value($field_name);
      if ($flag !== NULL) {
        $preferences[] = ['label' => $label, 'value' => $flag ? t('Yes') : t('No')];
      }
    }
    $profile['preferences'] = $preferences;

    $organizations = [];
    $cache->addCacheTags(['user_list']);
    $organization_ids = \Drupal::entityQuery('user')
      ->accessCheck(FALSE)
      ->condition('type', 'organization')
      ->condition('field_manager', $user->id())
      ->sort('field_name')
      ->execute();
    $view_builder = $entity_type_manager->getViewBuilder('user');
    foreach (Organization::loadMultiple($organization_ids) as $organization) {
      $access = $organization->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($organization);
      if ($access->isAllowed()) {
        $organizations[] = $view_builder->view($organization, 'teaser');
      }
    }
    $profile['organizations'] = $organizations;

    // Counts only the projects the viewer may see, as the projects list does.
    $project_storage = $entity_type_manager->getStorage('project');
    $cache->addCacheTags(['project_list']);
    $project_ids = $project_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition($project_storage->getQuery()->orConditionGroup()
        ->condition('field_participants', $user->id())
        ->condition('field_applicants', $user->id()))
      ->execute();
    $counts = ['completed' => 0, 'ongoing' => 0, 'applied' => 0];
    /** @var \Drupal\projects\ProjectInterface $project */
    foreach ($project_storage->loadMultiple($project_ids) as $project) {
      $access = $project->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($project);
      if (!$access->isAllowed()) {
        continue;
      }
      $lifecycle = $project->lifecycle();
      $participant = $project->isParticipant($user);
      match (TRUE) {
        $participant && $lifecycle->isCompleted() => $counts['completed']++,
        $participant && $lifecycle->isOngoing() => $counts['ongoing']++,
        $project->isApplicant($user) && $lifecycle->isOpen() => $counts['applied']++,
        default => NULL,
      };
    }
    $profile['projects'] = array_filter([
      $counts['completed'] ? \Drupal::translation()->formatPlural($counts['completed'], '1 completed', '@count completed') : NULL,
      $counts['ongoing'] ? \Drupal::translation()->formatPlural($counts['ongoing'], '1 ongoing', '@count ongoing') : NULL,
      $counts['applied'] ? \Drupal::translation()->formatPlural($counts['applied'], '1 application', '@count applications') : NULL,
    ]);

    $profile['courses'] = [];
    if ($staff->isAllowed()) {
      $cache->addCacheTags(['course_progress_list', 'lecture_progress_list']);
      $progress_storage = $entity_type_manager->getStorage('course_progress');
      $lecture_progress_storage = $entity_type_manager->getStorage('lecture_progress');
      $progress_ids = $progress_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('uid', $user->id())
        ->sort('enrolled')
        ->execute();
      /** @var \Drupal\progress\Entity\CourseProgress $progress */
      foreach ($progress_storage->loadMultiple($progress_ids) as $progress) {
        $course = $progress->get('course')->entity;
        if (!$course instanceof Course) {
          continue;
        }
        $cache->addCacheableDependency($course);
        $lecture_ids = array_map(static fn ($lecture) => $lecture->id(), $course->getLectures());
        $completed_lectures = $lecture_ids ? (int) $lecture_progress_storage->getQuery()
          ->accessCheck(FALSE)
          ->condition('uid', $user->id())
          ->condition('lecture', $lecture_ids, 'IN')
          ->condition('completed', 0, '>')
          ->count()
          ->execute() : 0;
        $completed = $progress->getCompletedTime();
        $profile['courses'][] = [
          'title' => $course->label(),
          'status' => $completed
            ? t('Completed @date', ['@date' => $date_formatter->format($completed, 'custom', 'd.m.Y')])
            : t('@done of @total lectures', ['@done' => $completed_lectures, '@total' => count($lecture_ids)]),
        ];
      }
    }
  }

  $profile['feedback'] = [];
  if ($staff->isAllowed()) {
    $cache->addCacheTags(['feedback_list']);
    $feedback_ids = $entity_type_manager->getStorage('feedback')->getQuery()
      ->accessCheck(FALSE)
      ->condition('bundle', $user instanceof Organization ? 'organization' : 'creative')
      ->condition('author', $user->id())
      ->condition('completed', NULL, 'IS NOT NULL')
      ->sort('completed', 'DESC')
      ->execute();
    /** @var \Drupal\feedback\Entity\Feedback $feedback */
    foreach ($entity_type_manager->getStorage('feedback')->loadMultiple($feedback_ids) as $feedback) {
      $project = $feedback->get('project')->entity;
      if (!$project instanceof ProjectInterface) {
        continue;
      }
      $access = $feedback->access('view', NULL, TRUE);
      $cache->addCacheableDependency($access)->addCacheableDependency($project);
      $profile['feedback'][] = [
        'project' => $project->getTitle(),
        'url' => $access->isAllowed() ? $feedback->toUrl()->toString() : NULL,
        'date' => $date_formatter->format((int) $feedback->get('completed')->value, 'custom', 'd.m.Y'),
      ];
    }
  }

  $account = [];
  foreach (['status', 'roles', 'created', 'login', 'access'] as $field_name) {
    $access = $user->get($field_name)->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $account[$field_name] = TRUE;
    }
  }
  if (isset($account['status'])) {
    $account['status'] = $user->isActive() ? t('Active') : t('Blocked');
  }
  if (isset($account['roles'])) {
    $roles = $entity_type_manager->getStorage('user_role')
      ->loadMultiple($user->getRoles(TRUE));
    $account['roles'] = implode(', ', array_map(static fn ($role) => $role->label(), $roles));
    foreach ($roles as $role) {
      $cache->addCacheableDependency($role);
    }
  }
  if (isset($account['created'])) {
    $account['created'] = $date_formatter->format($user->getCreatedTime(), 'custom', 'd.m.Y');
  }
  if (isset($account['login'])) {
    $login = $user->getLastLoginTime();
    $account['login'] = $login ? $date_formatter->format((int) $login, 'custom', 'd.m.Y') : t('Never');
  }
  if (isset($account['access'])) {
    $last_access = $user->getLastAccessedTime();
    $account['access'] = $last_access ? $date_formatter->format((int) $last_access, 'custom', 'd.m.Y') : t('Never');
  }
  $profile['account'] = array_filter($account);

  $variables['profile'] = $profile;
  $variables['profile_cache'] = [];
  $cache->applyTo($variables['profile_cache']);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_unformatted.
 *
 * Adds the creative's role to the project teasers on a creative's profile.
 * The role is part of the cache keys, because the same teasers show elsewhere
 * without it.
 */
function yv_preprocess_views_view_unformatted(array &$variables): void {

  $view = $variables['view'];
  if ($view->id() !== 'creative_projects') {
    return;
  }

  $creative = (int) ($view->args[0] ?? 0);
  foreach ($variables['rows'] as $key => &$row) {
    $project = $view->result[$key]->_entity ?? NULL;
    if (!$project instanceof ProjectInterface) {
      continue;
    }
    $owner = $project->getOwner();
    $role = match (TRUE) {
      $owner instanceof Organization && $owner->getManager()?->id() == $creative => 'managed',
      $project->isParticipant($creative) => 'participant',
      $project->isApplicant($creative) && $project->lifecycle()->isOpen() => 'applied',
      default => NULL,
    };
    if ($role) {
      $row['content']['#creative_role'] = $role;
      $row['content']['#cache']['keys'][] = $role;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for project.
 *
 * The teaser names the organization by its short name, as the frontend does.
 * The full view is prepared by yv_preprocess_project_full().
 */
function yv_preprocess_project(array &$variables): void {

  $project = $variables['elements']['#project'];
  if ($project instanceof ProjectInterface && $variables['elements']['#view_mode'] === 'full') {
    yv_preprocess_project_full($variables, $project);
    return;
  }
  if (!$project instanceof ProjectInterface || $variables['elements']['#view_mode'] !== 'teaser') {
    return;
  }

  $cache = new CacheableMetadata();
  $access = $project->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  $variables['url'] = $access->isAllowed() ? $project->toUrl()->toString() : NULL;

  $variables['creative_role'] = $variables['elements']['#creative_role'] ?? NULL;
  $variables['organization'] = NULL;
  $owner = $project->getOwner();
  if ($owner instanceof Organization) {
    $cache->addCacheableDependency($owner);
    foreach (['field_short_name', 'field_name'] as $field_name) {
      $field_access = $owner->get($field_name)->access('view', NULL, TRUE);
      $cache->addCacheableDependency($field_access);
      $name = trim((string) $owner->get($field_name)->value);
      if ($field_access->isAllowed() && $name !== '') {
        $variables['organization'] = $name;
        break;
      }
    }
  }

  $variables['project_cache'] = [];
  $cache->applyTo($variables['project_cache']);
}

/**
 * Prepares the full view of a project, its page in the backend.
 *
 * The plain fields come from the full display in "content". Here are only
 * the values the display cannot provide, each set only when the viewer may
 * see its fields, as on the profiles. The cacheability bubbles up through
 * project_cache.
 */
function yv_preprocess_project_full(array &$variables, ProjectInterface $project): void {

  $cache = CacheableMetadata::createFromObject($project);
  yv_content_cache($variables['content'], $cache);
  $states = yv_project_states($project, $cache);

  $page = [
    'title' => $project->getTitle(),
    // The raw state for the color of the badge, whose label is the field.
    'state' => (string) $project->get('field_lifecycle')->value,
    'archived' => !$project->isPublished(),
    'hidden' => $project->isHidden(),
    'promoted' => $project->isPromoted(),
    // The display shows the body, the summary is its own value.
    'summary' => yv_field_shows($project, 'body', $cache) ? trim((string) $project->get('body')->summary) ?: NULL : NULL,
    'facts' => yv_project_facts($project, $cache),
  ];
  $page += yv_project_people($project, $cache);
  $page += yv_project_result($project, $cache);
  $page += yv_project_details($project, $page, $cache);
  $page['history'] = yv_project_history($project, $states, $cache);
  $page['feedback'] = yv_project_feedback($project, $cache);

  $variables['project_page'] = $page;
  $variables['project_cache'] = [];
  $cache->applyTo($variables['project_cache']);
}

/**
 * Collects the cacheability of the fields of a display.
 *
 * A template that prints single fields, and not the whole content, would
 * lose the cacheability of the fields it leaves out, such as the access
 * result of a field the viewer may not see.
 */
function yv_content_cache(array $content, CacheableMetadata $cache): void {
  foreach (Element::children($content) as $key) {
    $cache->addCacheableDependency(CacheableMetadata::createFromRenderArray($content[$key]));
  }
}

/**
 * Whether the viewer may see a field of an entity, and it has a value.
 */
function yv_field_shows(FieldableEntityInterface $entity, string $field_name, CacheableMetadata $cache): bool {
  $access = $entity->get($field_name)->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  return $access->isAllowed() && !$entity->get($field_name)->isEmpty();
}

/**
 * Gets the trimmed value of a field the viewer may see, NULL if empty.
 */
function yv_field_value(FieldableEntityInterface $entity, string $field_name, CacheableMetadata $cache): ?string {
  $value = yv_field_shows($entity, $field_name, $cache) ? trim((string) $entity->get($field_name)->value) : '';
  return $value !== '' ? $value : NULL;
}

/**
 * Gets the name of an organization or a creative, if the viewer may see it.
 */
function yv_person_name(Organization|Creative $user, CacheableMetadata $cache): string {
  $cache->addCacheableDependency($user);
  return yv_field_value($user, 'field_name', $cache) ?? (string) t('Unknown');
}

/**
 * Gets a person as on the profiles.
 *
 * @return array
 *   The avatar or the initials, the name, the role and a link to the
 *   profile, if the viewer may open it.
 */
function yv_person(Organization|Creative $user, ?string $role, CacheableMetadata $cache): array {
  $name = yv_person_name($user, $cache);
  $access = $user->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  return [
    'name' => $name,
    'initials' => yv_initials($name),
    'avatar' => yv_avatar($user, $cache),
    'role' => $role,
    'url' => $access->isAllowed() ? $user->toUrl()->toString() : NULL,
  ];
}

/**
 * Gets the avatar of an organization or a creative as decoration.
 *
 * The avatar always stands next to the name, so its alt text would only
 * precede the name for screen readers.
 */
function yv_avatar(Organization|Creative $user, CacheableMetadata $cache): ?array {
  if (!yv_field_shows($user, 'field_avatar', $cache)) {
    return NULL;
  }
  $file = $user->get('field_avatar')->entity;
  if (!$file instanceof FileInterface) {
    return NULL;
  }
  $cache->addCacheableDependency($file);
  return [
    '#theme' => 'image_style',
    '#style_name' => 'avatar',
    '#uri' => $file->getFileUri(),
    '#alt' => '',
  ];
}

/**
 * Gets the labels of the lifecycle states, keyed by state.
 */
function yv_project_states(ProjectInterface $project, CacheableMetadata $cache): array {
  $lifecycle = $project->get('field_lifecycle')->first();
  if (!$lifecycle instanceof LifecycleItem) {
    return [];
  }
  if ($workflow = $lifecycle->getWorkflow()) {
    $cache->addCacheableDependency($workflow);
  }
  return $lifecycle->getPossibleOptions();
}

/**
 * Gets the label of a participant's task, as the sections of the sidebar.
 *
 * The participants store the tasks capitalized, the comments in lowercase.
 */
function yv_project_task_label(string $task): ?string {
  return match (mb_strtolower($task)) {
    'creative' => (string) t('Creative'),
    'manager' => (string) t('Manager'),
    default => $task !== '' ? $task : NULL,
  };
}

/**
 * Gets the workload and the location, the facts the display cannot show.
 */
function yv_project_facts(ProjectInterface $project, CacheableMetadata $cache): array {
  // The deadline comes from the display.
  $facts = [];
  $workload = (float) yv_field_value($project, 'field_workload', $cache);
  if ($workload > 0) {
    $days = (string) $workload;
    $facts['workload'] = [
      'label' => t('Workload'),
      'value' => $days === '1' ? t('1 day') : t('@count days', ['@count' => $days]),
    ];
  }
  // Unset is not remote; a stored "no" does not count as empty.
  if (yv_field_shows($project, 'field_local', $cache)) {
    $facts['location'] = [
      'label' => t('Location'),
      'value' => $project->get('field_local')->value ? (yv_field_value($project, 'field_city', $cache) ?? t('On site')) : t('Remote'),
    ];
  }
  return array_filter($facts, static fn (array $fact): bool => (string) $fact['value'] !== '');
}

/**
 * Gets the organization, manager, participants and applicants of a project.
 */
function yv_project_people(ProjectInterface $project, CacheableMetadata $cache): array {

  // The contact is a name, not an account, so it is shown as a detail of the
  // organization: the contact at the time of the project.
  $organization = $project->getOwner();
  $contact = yv_field_value($project, 'field_contact', $cache);
  $people = [
    'organization' => yv_person($organization, $contact ? (string) t('Contact: @name', ['@name' => $contact]) : NULL, $cache),
    'manager' => NULL,
    'participants' => [],
    'applicants' => [],
  ];

  if ($organization instanceof Organization) {
    $access = $organization->get('field_manager')->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    $manager = $access->isAllowed() ? $organization->getManager() : NULL;
    if ($manager) {
      $people['manager'] = yv_person($manager, NULL, $cache);
    }
  }

  if (yv_field_shows($project, 'field_participants', $cache)) {
    // The tasks have their own access, which can be stricter.
    $tasks = yv_field_shows($project, 'field_participants_tasks', $cache);
    foreach ($project->getParticipants() as $participant) {
      if ($participant instanceof Creative) {
        // @phpstan-ignore-next-line
        $role = $tasks ? yv_project_task_label((string) $participant->task) : NULL;
        $people['participants'][] = yv_person($participant, $role, $cache);
      }
    }
  }
  if (yv_field_shows($project, 'field_applicants', $cache)) {
    foreach ($project->getApplicants() as $applicant) {
      $people['applicants'][] = yv_person($applicant, NULL, $cache);
    }
  }
  return $people;
}

/**
 * Gets the result of a completed project.
 *
 * @return array
 *   The result: the files and links in their order, each with its
 *   description, and the public comments of the feedback. And whether the
 *   page needs the lightbox for its images.
 */
function yv_project_result(ProjectInterface $project, CacheableMetadata $cache): array {

  // The result belongs to a completed project. Its field is viewable in every
  // state, so the state is checked here.
  $none = ['result' => [], 'lightbox' => FALSE];
  if (!$project->lifecycle()->isCompleted() || !yv_field_shows($project, 'project_result', $cache)) {
    return $none;
  }
  $result = $project->get('project_result')->entity;
  if (!$result instanceof ProjectResultInterface) {
    return $none;
  }
  $access = $result->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access)->addCacheableDependency($result);
  if (!$access->isAllowed()) {
    return $none;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $items = [];

  // The lightbox shows the images in a style generated up front.
  $lightbox_style = $entity_type_manager->getStorage('image_style')->load('content');
  if ($lightbox_style instanceof ImageStyleInterface) {
    $cache->addCacheableDependency($lightbox_style);
  }
  $file_values = $result->get('field_files')->getValue();
  $files = $entity_type_manager->getStorage('file')->loadMultiple(array_column($file_values, 'target_id'));
  foreach ($file_values as $value) {
    $file = $files[$value['target_id']] ?? NULL;
    if (!$file instanceof FileInterface) {
      continue;
    }
    $cache->addCacheableDependency($file);
    $image = str_starts_with((string) $file->getMimeType(), 'image/');
    $items[] = [
      'weight' => (int) ($value['weight'] ?? 0),
      'url' => $file->createFileUrl(),
      'name' => $file->getFilename(),
      'description' => trim((string) ($value['description'] ?? '')),
      // The teaser style is generated up front by image_style_warmer.
      'preview' => $image ? [
        '#theme' => 'image_style',
        '#style_name' => 'teaser',
        '#uri' => $file->getFileUri(),
        '#alt' => '',
      ] : NULL,
      'type' => mb_strtoupper(pathinfo($file->getFilename(), PATHINFO_EXTENSION)),
      'lightbox' => $image && $lightbox_style instanceof ImageStyleInterface ? $lightbox_style->buildUrl($file->getFileUri()) : NULL,
      'external' => FALSE,
    ];
  }

  // Url::isExternal() is TRUE for every absolute address, also for one of
  // this site, so a link leaves the website only if it is not local.
  $cache->addCacheContexts(['url.site']);
  $request = \Drupal::request();
  $base_url = $request->getSchemeAndHttpHost() . $request->getBasePath() . '/';
  foreach ($result->get('field_hyperlinks')->getValue() as $value) {
    $link = trim((string) $value['value']);
    if ($link === '') {
      continue;
    }
    // A value without an address, such as "https://www.", is left out, as on
    // the profiles.
    $name = rtrim(preg_replace('{^(https?://)?(www\.)?}i', '', $link), '/');
    if ($name === '') {
      continue;
    }
    // Only http(s) values become links, as on the profiles.
    $url = preg_match('{^https?://}i', $link) ? Url::fromUri($link) : NULL;
    $items[] = [
      'weight' => (int) ($value['weight'] ?? 0),
      'url' => $url?->toString(),
      'name' => $name,
      'description' => trim((string) ($value['description'] ?? '')),
      'preview' => NULL,
      'type' => (string) t('Link'),
      'lightbox' => NULL,
      'external' => $url && $url->isExternal() && !UrlHelper::externalIsLocal($link, $base_url),
    ];
  }
  usort($items, static fn (array $a, array $b): int => $a['weight'] <=> $b['weight']);

  $comments = [];
  foreach ($result->getComments() as $comment) {
    $cache->addCacheableDependency($comment);
    $author = $comment->getOwner();
    if (!$comment->get('status')->value || trim($comment->getComment()) === '') {
      continue;
    }
    if ($author instanceof Organization) {
      $comments[] = yv_person($author, (string) t('Organization'), $cache) + ['comment' => $comment->getComment()];
    }
    elseif ($author instanceof Creative) {
      $role = yv_project_task_label((string) $comment->get('task')->value);
      $comments[] = yv_person($author, $role, $cache) + ['comment' => $comment->getComment()];
    }
  }

  return [
    'result' => array_filter(['items' => $items, 'comments' => $comments]),
    'lightbox' => (bool) array_filter(array_column($items, 'lightbox')),
  ];
}

/**
 * Gets the details in the sidebar that the display cannot show.
 *
 * @param \Drupal\projects\ProjectInterface $project
 *   The project.
 * @param array $page
 *   The page so far, with the state and the flags of the project.
 * @param \Drupal\Core\Cache\CacheableMetadata $cache
 *   The cacheability of the page.
 *
 * @return array
 *   The reasons of a decline or the archiving, each with label and value,
 *   and the created and changed dates.
 */
function yv_project_details(ProjectInterface $project, array $page, CacheableMetadata $cache): array {

  $details = ['reasons' => [], 'created' => NULL, 'changed' => NULL];

  /** @var \Drupal\logbook\ProjectReasons $reasons */
  $reasons = \Drupal::service('logbook.project_reasons');
  if ($page['state'] === 'declined' && $reason = $reasons->getDeclineReason($project, $cache)) {
    $details['reasons'][] = ['label' => t('Decline reason'), 'value' => $reason->label()];
  }
  if ($page['archived'] && $reason = $reasons->getArchiveReason($project, $cache)) {
    $details['reasons'][] = ['label' => t('Archive reason'), 'value' => $reason->label()];
  }

  // The dates are base fields without a configurable display.
  $date_formatter = \Drupal::service('date.formatter');
  foreach (['created', 'changed'] as $field_name) {
    if (yv_field_shows($project, $field_name, $cache)) {
      $details[$field_name] = $date_formatter->format((int) $project->get($field_name)->value, 'custom', 'd.m.Y');
    }
  }
  return $details;
}

/**
 * Gets the lifecycle, newest first: each state with the date it was reached.
 */
function yv_project_history(ProjectInterface $project, array $states, CacheableMetadata $cache): array {
  if (!yv_field_shows($project, 'field_lifecycle_history', $cache)) {
    return [];
  }
  $date_formatter = \Drupal::service('date.formatter');
  $history = [];
  foreach (array_reverse($project->get('field_lifecycle_history')->getValue()) as $item) {
    $history[] = [
      'label' => $states[$item['to']] ?? $item['to'],
      'date' => $date_formatter->format((int) $item['timestamp'], 'custom', 'd.m.Y'),
    ];
  }
  return $history;
}

/**
 * Gets the completed feedback on a project, as on the feedback page.
 *
 * Only the feedback the viewer may open is listed.
 */
function yv_project_feedback(ProjectInterface $project, CacheableMetadata $cache): array {

  $cache->addCacheTags(['feedback_list']);
  $storage = \Drupal::entityTypeManager()->getStorage('feedback');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('project', $project->id())
    ->condition('completed', NULL, 'IS NOT NULL')
    ->sort('completed', 'DESC')
    ->execute();
  $date_formatter = \Drupal::service('date.formatter');
  $feedback = [];
  /** @var \Drupal\feedback\FeedbackInterface $item */
  foreach ($storage->loadMultiple($ids) as $item) {
    $access = $item->access('view', NULL, TRUE);
    $cache->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      continue;
    }
    $cache->addCacheableDependency($item);
    $author = $item->getOwner();
    $feedback[] = [
      'name' => $author instanceof Organization || $author instanceof Creative ? yv_person_name($author, $cache) : (string) $item->label(),
      'url' => $item->toUrl()->toString(),
      'date' => $date_formatter->format((int) $item->get('completed')->value, 'custom', 'd.m.Y'),
    ];
  }
  return $feedback;
}

/**
 * Gets the initials of the first two words of a name.
 */
function yv_initials(?string $name): string {
  return implode('', array_map(
    static fn (string $word): string => mb_strtoupper(mb_substr($word, 0, 1)),
    array_slice(preg_grep('/^\p{L}/u', preg_split('/\s+/', (string) $name)), 0, 2),
  ));
}
