# OAuth consumers for the local DDEV site, read by oauth_grant.install when
# scripts/install-local.sh installs with CONFIG_ENV=local. Both frontend apps
# run on http://localhost:3000 (one at a time).
UUID_CREATIVE_LOCAL=12341234-1234-1234-1234-123412341234
REDIRECT_CREATIVE_LOCAL=http://localhost:3000/auth/callback
SECRET_CREATIVE_LOCAL=secret

UUID_ORGANIZATION_LOCAL=34563456-3456-3456-3456-345634563456
REDIRECT_ORGANIZATION_LOCAL=http://localhost:3000/auth/callback
SECRET_ORGANIZATION_LOCAL=secret
