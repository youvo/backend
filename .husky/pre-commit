if [ -x "vendor/bin/grumphp" ]; then
  echo "Running GrumPHP checks..."
  vendor/bin/grumphp git:pre-commit --ansi
  grumphp_status=$?

  if [ $grumphp_status -ne 0 ]; then
    echo "❌ GrumPHP checks failed."
    echo "💡 Tip: Run 'composer install' if dependencies are missing."
    exit $grumphp_status
  fi
fi

# Frontend build output is committed and deployed from git. Rebuild a package
# when its sources are staged and stage the output along with them. Paths after
# the package folder are relative to it: the output, then the sources.
build() {
  dir=$1 output=$2
  shift 2
  (cd "$dir" && git diff --cached --quiet -- "$@") && return
  if [ ! -d "$dir/node_modules" ]; then
    echo "⚠️  Skipping the $dir build, dependencies are not installed."
    return
  fi
  echo "Building $dir..."
  (cd "$dir" && npm run build >/dev/null && git add -- "$output")
}

